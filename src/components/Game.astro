<div
  class="casino-shell"
  data-blackjack-game
>
  <main
    class="game-stage"
    aria-label="First-person Blackjack 21 casino table"
  >
    <canvas
      id="game-canvas"
      class="game-canvas"
      aria-label="Blackjack casino table"
    ></canvas>

    <div
      class="ambient-info ambient-info--left"
      aria-hidden="true"
    >
      <span>TABLE 07</span>
    </div>

    <div
      class="ambient-info ambient-info--right"
      aria-hidden="true"
    >
      <span>BLACKJACK 21</span>
    </div>

    <div
      class="player-foreground"
      aria-hidden="true"
    >
      <div class="player-forearm player-forearm--left"></div>
      <div class="player-forearm player-forearm--right"></div>
      <div class="player-seat-shadow"></div>
    </div>

    <section
      id="game-info"
      class="game-info"
      aria-label="Current blackjack status"
    >
      <div class="game-info-row">
        <span class="game-info-label">BANK</span>
        <strong id="bankroll-value">$0</strong>
      </div>

      <div class="game-info-row">
        <span class="game-info-label">BET</span>
        <strong id="bet-value">$0</strong>
      </div>

      <div
        id="hand-value"
        class="game-info-value"
        aria-live="polite"
      >
        —
      </div>
    </section>

    <div
      id="round-status"
      class="round-status"
      aria-live="polite"
    >
      PLACE YOUR BET
    </div>

    <div
      id="bet-controls"
      class="bet-controls"
      aria-label="Betting controls"
    >
      <button
        type="button"
        class="table-button table-button--bet"
        data-action="decrease-bet"
        aria-label="Decrease bet by 5"
      >
        −
      </button>

      <div class="bet-amount">
        <span id="bet-display">$0</span>
      </div>

      <button
        type="button"
        class="table-button table-button--bet"
        data-action="increase-bet"
        aria-label="Increase bet by 5"
      >
        +
      </button>
    </div>

    <div
      id="action-controls"
      class="action-controls"
      aria-label="Blackjack actions"
    >
      <button
        type="button"
        class="table-button"
        data-action="deal"
        data-visible-phase="betting"
      >
        DEAL
      </button>

      <button
        type="button"
        class="table-button"
        data-action="hit"
        data-visible-phase="player-turn"
      >
        HIT
      </button>

      <button
        type="button"
        class="table-button"
        data-action="stand"
        data-visible-phase="player-turn"
      >
        STAND
      </button>

      <button
        type="button"
        class="table-button"
        data-action="double"
        data-visible-phase="player-turn"
      >
        DOUBLE
      </button>

      <button
        type="button"
        class="table-button"
        data-action="split"
        data-visible-phase="player-turn"
      >
        SPLIT
      </button>

      <button
        type="button"
        class="table-button"
        data-action="insurance"
        data-visible-phase="insurance"
      >
        INSURE
      </button>

      <button
        type="button"
        class="table-button"
        data-action="decline-insurance"
        data-visible-phase="insurance"
      >
        NO
      </button>

      <button
        type="button"
        class="table-button table-button--danger"
        data-action="surrender"
        data-visible-phase="player-turn"
      >
        SURRENDER
      </button>
    </div>

    <div
      class="table-atmosphere-mark"
      aria-hidden="true"
    >
      <span>DEALER STANDS ON 17</span>
      <i></i>
      <span>BLACKJACK PAYS 3 : 2</span>
    </div>

    <div
      class="scene-vignette"
      aria-hidden="true"
    ></div>

    <div
      class="scene-edge"
      aria-hidden="true"
    ></div>
  </main>

  <div
    id="loading-screen"
    class="loading-screen"
    aria-live="polite"
  >
    <div class="loading-mark">
      <span class="loading-suit">♠</span>

      <div class="loading-copy">
        <span>PRIVATE TABLE</span>
        <strong>BLACKJACK 21</strong>
      </div>
    </div>

    <div
      class="loading-bar"
      aria-hidden="true"
    >
      <div class="loading-bar-fill"></div>
    </div>
  </div>

  <div
    id="game-error"
    class="game-error"
    aria-live="assertive"
    hidden
  >
    <div class="game-error-inner">
      <span class="game-error-mark">!</span>

      <strong>TABLE ERROR</strong>

      <small id="game-error-copy">
        Blackjack failed to initialize.
      </small>

      <button
        id="game-error-reload"
        type="button"
        class="game-button-retry"
      >
        RETRY
      </button>
    </div>
  </div>
</div>

<script>
  import { Game } from "../game/Game";

  type Action =
    | "deal"
    | "hit"
    | "stand"
    | "double"
    | "split"
    | "insurance"
    | "decline-insurance"
    | "surrender"
    | "increase-bet"
    | "decrease-bet";

  type BlackjackRuntimeWindow =
    Window & {
      __BLACKJACK_GAME_INSTANCE__?: Game | null;
    };

  const runtimeWindow =
    window as BlackjackRuntimeWindow;

  /* =========================================================
     ROOT
     ========================================================= */

  const root =
    document.querySelector(
      "[data-blackjack-game]"
    ) as HTMLElement | null;

  if (!root) {
    throw new Error(
      "Blackjack Game root element was not found."
    );
  }

  /* =========================================================
     GAME
     ========================================================= */

  let game:
    Game | null =
    null;

  let initializing =
    false;

  let destroyed =
    false;

  let fatalVisible =
    false;

  /* =========================================================
     DOM
     ========================================================= */

  const query =
    <T extends Element>(
      selector: string
    ): T | null =>
      root.querySelector(
        selector
      ) as T | null;

  const canvas =
    query<HTMLCanvasElement>(
      "#game-canvas"
    );

  const loadingScreen =
    query<HTMLElement>(
      "#loading-screen"
    );

  const gameError =
    query<HTMLElement>(
      "#game-error"
    );

  const gameErrorCopy =
    query<HTMLElement>(
      "#game-error-copy"
    );

  const retryButton =
    query<HTMLButtonElement>(
      "#game-error-reload"
    );

  const bankrollValue =
    query<HTMLElement>(
      "#bankroll-value"
    );

  const betValue =
    query<HTMLElement>(
      "#bet-value"
    );

  const betDisplay =
    query<HTMLElement>(
      "#bet-display"
    );

  const handValue =
    query<HTMLElement>(
      "#hand-value"
    );

  const roundStatus =
    query<HTMLElement>(
      "#round-status"
    );

  const betControls =
    query<HTMLElement>(
      "#bet-controls"
    );

  const actionControls =
    query<HTMLElement>(
      "#action-controls"
    );

  const actionButtons =
    Array.from(
      root.querySelectorAll(
        "button[data-action]"
      )
    ) as HTMLButtonElement[];

  /* =========================================================
     HELPERS
     ========================================================= */

  const money =
    (
      value: number
    ): string => {

      const safe =
        Number.isFinite(
          value
        )
          ? value
          : 0;

      return `$${Math.max(
        0,
        Math.floor(
          safe
        )
      )}`;
    };

  const safeLog =
    (
      label: string,
      value?: unknown
    ): void => {

      try {
        console.error(
          label,
          value
        );
      } catch {
        /* logging must never crash the game */
      }
    };

  const getHuman =
    () =>
      game
        ?.blackjack
        .getHumanPlayer() ??
      null;

  const getHumanHand =
    () =>
      getHuman()
        ?.hand ??
      null;

  const getEnginePhase =
    () =>
      game
        ?.blackjack
        .phase ??
      "waiting";

  const setHidden =
    (
      element:
        | HTMLElement
        | null,
      hidden: boolean
    ): void => {

      if (!element) {
        return;
      }

      element.classList.toggle(
        "is-hidden",
        hidden
      );
    };

  /* =========================================================
     TABLE
     ========================================================= */

  const isTableAvailable =
    (): boolean => {

      if (
        !game ||
        destroyed
      ) {
        return false;
      }

      try {
        return game.isTableAvailable();
      } catch (error) {
        safeLog(
          "[BLACKJACK] Table availability check failed.",
          error
        );

        return false;
      }
    };

  /* =========================================================
     HAND RULES
     ========================================================= */

  const canDouble =
    (): boolean => {

      const player =
        getHuman();

      const hand =
        getHumanHand();

      if (
        !game ||
        !player ||
        !hand ||
        destroyed
      ) {
        return false;
      }

      if (
        game.blackjack.phase !==
        "player-turn"
      ) {
        return false;
      }

      if (
        game.blackjack.activeSeat !==
        player.seat
      ) {
        return false;
      }

      if (
        hand.cards.length !==
        2
      ) {
        return false;
      }

      return (
        player.balance >=
        hand.bet
      );
    };

  const canSplit =
    (): boolean => {

      const player =
        getHuman();

      const hand =
        getHumanHand();

      if (
        !game ||
        !player ||
        !hand ||
        destroyed
      ) {
        return false;
      }

      if (
        game.blackjack.phase !==
        "player-turn"
      ) {
        return false;
      }

      if (
        game.blackjack.activeSeat !==
        player.seat
      ) {
        return false;
      }

      if (
        hand.cards.length !==
        2
      ) {
        return false;
      }

      if (
        player.secondaryHand
      ) {
        return false;
      }

      if (
        player.balance <
        hand.bet
      ) {
        return false;
      }

      const first =
        hand.cards[0];

      const second =
        hand.cards[1];

      if (
        !first ||
        !second
      ) {
        return false;
      }

      return (
        first.value ===
        second.value
      );
    };

  const canSurrender =
    (): boolean => {

      const player =
        getHuman();

      const hand =
        getHumanHand();

      if (
        !game ||
        !player ||
        !hand ||
        destroyed
      ) {
        return false;
      }

      return (
        game.blackjack.allowSurrender &&
        game.blackjack.phase ===
          "player-turn" &&
        game.blackjack.activeSeat ===
          player.seat &&
        hand.cards.length ===
          2 &&
        !hand.blackjack
      );
    };

  /* =========================================================
     RESULT
     ========================================================= */

  const getResultText =
    (): string => {

      if (
        !game ||
        destroyed
      ) {
        return "ROUND OVER";
      }

      const human =
        getHuman();

      if (!human) {
        return "ROUND OVER";
      }

      const result =
        game.blackjack.settlements.find(
          (
            settlement
          ) => {

            if (
              settlement.playerId !==
              human.id
            ) {
              return false;
            }

            return (
              typeof settlement.handId ===
                "string" &&
              !settlement.handId.startsWith(
                "insurance-"
              )
            );
          }
        );

      if (!result) {
        return "ROUND OVER";
      }

      switch (
        result.result
      ) {

        case "blackjack":
          return "BLACKJACK";

        case "win":
          return "YOU WIN";

        case "loss":
        case "bust":
          return "YOU LOSE";

        case "push":
          return "PUSH";

        case "surrender":
          return "SURRENDER";

        default:
          return "ROUND OVER";
      }
    };

  /* =========================================================
     LOADING
     ========================================================= */

  const showLoading =
    (): void => {

      loadingScreen?.classList.remove(
        "loading-screen--hidden"
      );
    };

  const hideLoading =
    (): void => {

      loadingScreen?.classList.add(
        "loading-screen--hidden"
      );
    };

  /* =========================================================
     FATAL ERROR
     ========================================================= */

  const formatError =
    (
      error: unknown
    ): string => {

      if (
        error instanceof Error
      ) {

        return [
          error.message ||
            "Unknown error.",
          error.stack
            ? `\n\nSTACK:\n${error.stack}`
            : ""
        ].join("");
      }

      if (
        typeof error ===
        "string"
      ) {
        return error;
      }

      if (
        error ===
        undefined
      ) {
        return "Unknown initialization error.";
      }

      try {
        return JSON.stringify(
          error,
          null,
          2
        );
      } catch {
        return String(
          error
        );
      }
    };

  const showFatalError =
    (
      error?: unknown
    ): void => {

      fatalVisible =
        true;

      safeLog(
        "[BLACKJACK FATAL ERROR]",
        error
      );

      if (
        gameErrorCopy
      ) {
        gameErrorCopy.textContent =
          formatError(
            error
          );
      }

      if (
        gameError
      ) {
        gameError.hidden =
          false;

        gameError.setAttribute(
          "aria-hidden",
          "false"
        );
      }

      hideLoading();
    };

  const clearFatalError =
    (): void => {

      fatalVisible =
        false;

      if (
        gameError
      ) {
        gameError.hidden =
          true;

        gameError.setAttribute(
          "aria-hidden",
          "true"
        );
      }

      if (
        gameErrorCopy
      ) {
        gameErrorCopy.textContent =
          "Blackjack failed to initialize.";
      }
    };

  /* =========================================================
     DEBUG
     ========================================================= */

  const exposeDebugGame =
    (): void => {

      runtimeWindow.__BLACKJACK_GAME_INSTANCE__ =
        game;
    };

  /* =========================================================
     UI
     ========================================================= */

  const updateGameUI =
    (): void => {

      if (
        !game ||
        destroyed
      ) {
        return;
      }

      const player =
        getHuman();

      if (!player) {

        if (
          roundStatus
        ) {
          roundStatus.textContent =
            "TABLE READY";
        }

        if (
          bankrollValue
        ) {
          bankrollValue.textContent =
            "$0";
        }

        if (
          betValue
        ) {
          betValue.textContent =
            "$0";
        }

        if (
          betDisplay
        ) {
          betDisplay.textContent =
            "$0";
        }

        if (
          handValue
        ) {
          handValue.textContent =
            "—";
        }

        setHidden(
          betControls,
          true
        );

        setHidden(
          actionControls,
          true
        );

        return;
      }

      const phase =
        getEnginePhase();

      const hand =
        getHumanHand();

      const balance =
        Number.isFinite(
          player.balance
        )
          ? player.balance
          : 0;

      const bet =
        Number.isFinite(
          player.bet
        )
          ? player.bet
          : 0;

      /*
       * MONEY
       */

      if (
        bankrollValue
      ) {
        bankrollValue.textContent =
          money(
            balance
          );
      }

      if (
        betValue
      ) {
        betValue.textContent =
          money(
            bet
          );
      }

      if (
        betDisplay
      ) {
        betDisplay.textContent =
          money(
            bet
          );
      }

      /*
       * HAND VALUE
       */

      if (
        handValue
      ) {

        const shouldShow =
          phase ===
            "player-turn" ||
          phase ===
            "dealer-turn" ||
          phase ===
            "settlement" ||
          phase ===
            "complete";

        if (
          shouldShow &&
          hand &&
          hand.cards.length > 0
        ) {

          handValue.textContent =
            String(
              hand.value
            );

        } else {

          handValue.textContent =
            "—";
        }
      }

      /*
       * STATUS
       */

      let status =
        "PLACE YOUR BET";

      switch (
        phase
      ) {

        case "waiting":
        case "betting":

          status =
            bet >=
            game.blackjack.minimumBet
              ? "READY TO DEAL"
              : "PLACE YOUR BET";

          break;

        case "initial-deal":

          status =
            "DEALING";

          break;

        case "insurance":

          status =
            "INSURANCE?";

          break;

        case "player-turn":

          status =
            game.blackjack.activeSeat ===
            player.seat
              ? "YOUR TURN"
              : "OTHER PLAYERS";

          break;

        case "dealer-turn":

          status =
            "DEALER";

          break;

        case "settlement":

          status =
            "SETTLING";

          break;

        case "complete":

          status =
            getResultText();

          break;

        default:

          status =
            "PLACE YOUR BET";
      }

      if (
        roundStatus
      ) {
        roundStatus.textContent =
          status;
      }

      /*
       * BETTING
       */

      const bettingVisible =
        phase ===
          "waiting" ||
        phase ===
          "betting" ||
        phase ===
          "complete";

      const tableReady =
        isTableAvailable();

      setHidden(
        betControls,
        !(
          bettingVisible &&
          tableReady
        )
      );

      /*
       * ACTIONS
       */

      for (
        const button of
          actionButtons
      ) {

        const action =
          button.dataset.action;

        if (!action) {
          continue;
        }

        const visiblePhase =
          button.dataset.visiblePhase;

        let visible =
          false;

        switch (
          action
        ) {

          case "increase-bet":
          case "decrease-bet":

            visible =
              bettingVisible &&
              tableReady;

            break;

          case "deal":

            visible =
              bettingVisible &&
              tableReady;

            break;

          case "hit":
          case "stand":

            visible =
              phase ===
                "player-turn" &&
              game.blackjack.activeSeat ===
                player.seat;

            break;

          case "double":

            visible =
              phase ===
                "player-turn" &&
              canDouble();

            break;

          case "split":

            visible =
              phase ===
                "player-turn" &&
              canSplit();

            break;

          case "surrender":

            visible =
              phase ===
                "player-turn" &&
              canSurrender();

            break;

          case "insurance":
          case "decline-insurance":

            visible =
              phase ===
              "insurance";

            break;

          default:

            visible =
              visiblePhase ===
              phase;
        }

        button.classList.toggle(
          "is-hidden",
          !visible
        );

        button.disabled =
          !visible;
      }

      /*
       * BET BUTTONS
       */

      const minimumBet =
        game.blackjack.minimumBet;

      const maximumBet =
        game.blackjack.maximumBet;

      const canAffordMinimum =
        balance >=
        minimumBet;

      const increaseButton =
        actionButtons.find(
          (
            button
          ) =>
            button.dataset.action ===
            "increase-bet"
        );

      const decreaseButton =
        actionButtons.find(
          (
            button
          ) =>
            button.dataset.action ===
            "decrease-bet"
        );

      if (
        increaseButton
      ) {

        increaseButton.disabled =
          !(
            bettingVisible &&
            tableReady &&
            canAffordMinimum &&
            balance > 0 &&
            bet <
              Math.min(
                maximumBet,
                balance
              )
          );
      }

      if (
        decreaseButton
      ) {

        decreaseButton.disabled =
          !(
            bettingVisible &&
            tableReady &&
            bet > 0
          );
      }

      /*
       * DEAL
       */

      const dealButton =
        actionButtons.find(
          (
            button
          ) =>
            button.dataset.action ===
            "deal"
        );

      if (
        dealButton
      ) {

        dealButton.disabled =
          !(
            bettingVisible &&
            tableReady &&
            canAffordMinimum &&
            bet >=
              minimumBet
          );
      }

      /*
       * ACTION CONTAINER
       */

      const anyVisibleAction =
        actionButtons.some(
          (
            button
          ) =>
            !button.classList.contains(
              "is-hidden"
            )
        );

      setHidden(
        actionControls,
        !anyVisibleAction
      );
    };

  /* =========================================================
     ACTIONS
     ========================================================= */

  const executeAction =
    (
      action: Action
    ): void => {

      if (
        !game ||
        destroyed
      ) {
        return;
      }

      try {

        switch (
          action
        ) {

          case "deal":
            game.deal();
            break;

          case "hit":
            game.hit();
            break;

          case "stand":
            game.stand();
            break;

          case "double":
            game.double();
            break;

          case "split":
            game.split();
            break;

          case "insurance":
            game.insurance();
            break;

          case "decline-insurance":
            game.declineInsurance();
            break;

          case "surrender":
            game.surrender();
            break;

          case "increase-bet":
            game.increaseBet(5);
            break;

          case "decrease-bet":
            game.decreaseBet(5);
            break;
        }

      } catch (error) {

        /*
         * An action failure must not destroy
         * the entire table.
         */
        safeLog(
          `[BLACKJACK ACTION ERROR] ${action}`,
          error
        );

        if (
          roundStatus
        ) {
          roundStatus.textContent =
            "ACTION FAILED";
        }

        return;
      }

      try {
        updateGameUI();
      } catch (error) {

        safeLog(
          "[BLACKJACK] UI refresh after action failed.",
          error
        );
      }
    };

  /* =========================================================
     ENGINE EVENTS
     ========================================================= */

  const engineEventNames = [
    "round:start",
    "round:phase",
    "bet:change",
    "cards:deal",
    "card:draw",
    "card:flip",
    "player:turn",
    "player:action",
    "dealer:turn",
    "dealer:action",
    "round:settle",
    "round:complete",
    "error",
  ] as const;

  const engineUnsubscribers:
    Array<() => void> = [];

  const clearEngineSubscriptions =
    (): void => {

      while (
        engineUnsubscribers.length >
        0
      ) {

        const unsubscribe =
          engineUnsubscribers.pop();

        if (
          typeof unsubscribe !==
          "function"
        ) {
          continue;
        }

        try {
          unsubscribe();
        } catch (error) {

          safeLog(
            "[BLACKJACK] Engine unsubscribe failed.",
            error
          );
        }
      }
    };

  const subscribeToEngine =
    (): void => {

      clearEngineSubscriptions();

      if (
        !game ||
        destroyed
      ) {
        return;
      }

      for (
        const eventName of
          engineEventNames
      ) {

        const unsubscribe =
          game.blackjack.on(
            eventName,
            () => {

              if (
                destroyed
              ) {
                return;
              }

              try {
                updateGameUI();
              } catch (error) {

                safeLog(
                  `[BLACKJACK UI UPDATE ERROR] ${eventName}`,
                  error
                );
              }
            }
          );

        if (
          typeof unsubscribe ===
          "function"
        ) {
          engineUnsubscribers.push(
            unsubscribe
          );
        }
      }
    };

  /* =========================================================
     BUTTONS
     ========================================================= */

  const buttonHandlers:
    Array<{
      button: HTMLButtonElement;
      handler: () => void;
    }> = [];

  for (
    const button of
      actionButtons
  ) {

    const rawAction =
      button.dataset.action;

    if (!rawAction) {
      continue;
    }

    const action =
      rawAction as Action;

    const handler =
      (): void => {
        executeAction(
          action
        );
      };

    button.addEventListener(
      "click",
      handler
    );

    buttonHandlers.push({
      button,
      handler,
    });
  }

  /* =========================================================
     CUSTOM EVENTS
     ========================================================= */

  const globalActionHandler =
    (): void => {

      if (
        destroyed
      ) {
        return;
      }

      try {
        updateGameUI();
      } catch (error) {

        safeLog(
          "[BLACKJACK] Global action refresh failed.",
          error
        );
      }
    };

  const visualEventNames = [
    "blackjack:visual:card-draw",
    "blackjack:visual:card-flip",
    "blackjack:visual:player-action",
    "blackjack:visual:dealer-action",
    "blackjack:visual:settlement",
    "blackjack:visual:round-complete",
  ] as const;

  const visualEventHandler =
    (): void => {

      if (
        destroyed
      ) {
        return;
      }

      try {
        updateGameUI();
      } catch (error) {

        safeLog(
          "[BLACKJACK] Visual event refresh failed.",
          error
        );
      }
    };

  /* =========================================================
     GLOBAL ERROR LOGGING
     ========================================================= */

  /*
   * IMPORTANT:
   *
   * Global browser errors are LOGGED only.
   *
   * They no longer force TABLE ERROR.
   *
   * The initialization try/catch below is the
   * authoritative startup error boundary.
   */

  const globalErrorHandler =
    (
      event: ErrorEvent
    ): void => {

      safeLog(
        "[BLACKJACK WINDOW ERROR]",
        {
          message:
            event.message,
          filename:
            event.filename,
          line:
            event.lineno,
          column:
            event.colno,
          error:
            event.error,
        }
      );
    };

  const unhandledRejectionHandler =
    (
      event: PromiseRejectionEvent
    ): void => {

      safeLog(
        "[BLACKJACK UNHANDLED REJECTION]",
        event.reason
      );
    };

  /* =========================================================
     EVENTS
     ========================================================= */

  window.addEventListener(
    "error",
    globalErrorHandler
  );

  window.addEventListener(
    "unhandledrejection",
    unhandledRejectionHandler
  );

  window.addEventListener(
    "blackjack:action",
    globalActionHandler
  );

  for (
    const eventName of
      visualEventNames
  ) {

    window.addEventListener(
      eventName,
      visualEventHandler
    );
  }

  /* =========================================================
     RETRY
     ========================================================= */

  function retryHandler():
    void {

    if (
      initializing ||
      destroyed
    ) {
      return;
    }

    initialize();
  }

  retryButton?.addEventListener(
    "click",
    retryHandler
  );

  /* =========================================================
     DESTROY
     ========================================================= */

  function destroy():
    void {

    if (
      destroyed
    ) {
      return;
    }

    destroyed =
      true;

    clearEngineSubscriptions();

    for (
      const item of
        buttonHandlers
    ) {

      try {
        item.button.removeEventListener(
          "click",
          item.handler
        );
      } catch {
        /* ignore cleanup failure */
      }
    }

    retryButton?.removeEventListener(
      "click",
      retryHandler
    );

    window.removeEventListener(
      "error",
      globalErrorHandler
    );

    window.removeEventListener(
      "unhandledrejection",
      unhandledRejectionHandler
    );

    window.removeEventListener(
      "blackjack:action",
      globalActionHandler
    );

    for (
      const eventName of
        visualEventNames
    ) {

      window.removeEventListener(
        eventName,
        visualEventHandler
      );
    }

    try {
      game?.destroy();
    } catch (error) {

      safeLog(
        "[BLACKJACK] Game cleanup failed.",
        error
      );
    }

    game =
      null;

    runtimeWindow.__BLACKJACK_GAME_INSTANCE__ =
      null;
  }

  /* =========================================================
     INITIALIZE
     ========================================================= */

  function initialize():
    void {

    if (
      initializing ||
      destroyed
    ) {
      return;
    }

    initializing =
      true;

    clearFatalError();
    showLoading();

    try {

      console.info(
        "[BLACKJACK] Initialization started."
      );

      /*
       * Remove old game instance.
       */
      if (
        game
      ) {

        console.info(
          "[BLACKJACK] Destroying previous game instance."
        );

        try {
          game.destroy();
        } catch (error) {

          safeLog(
            "[BLACKJACK] Previous game cleanup failed.",
            error
          );
        }

        game =
          null;
      }

      clearEngineSubscriptions();
      exposeDebugGame();

      /*
       * Canvas.
       */
      if (
        !canvas
      ) {
        throw new Error(
          "Game canvas was not found."
        );
      }

      if (
        !(canvas instanceof HTMLCanvasElement)
      ) {
        throw new Error(
          "Game canvas is not an HTMLCanvasElement."
        );
      }

      const rect =
        canvas.getBoundingClientRect();

      console.info(
        "[BLACKJACK] Canvas validated.",
        {
          width:
            rect.width,
          height:
            rect.height,
        }
      );

      /*
       * Zero size is a warning, not fatal.
       */
      if (
        rect.width <= 0 ||
        rect.height <= 0
      ) {

        console.warn(
          "[BLACKJACK] Canvas has zero size during initialization."
        );
      }

      /*
       * Create Game.
       *
       * Game.ts itself already owns:
       *   - Renderer
       *   - Animation
       *   - Input
       *   - Resize
       *   - Main loop
       *   - Intro
       */
      console.info(
        "[BLACKJACK] Creating Game..."
      );

      game =
        new Game(
          canvas
        );

      console.info(
        "[BLACKJACK] Game created successfully."
      );

      exposeDebugGame();

      /*
       * Subscribe.
       */
      subscribeToEngine();

      console.info(
        "[BLACKJACK] Engine subscriptions ready."
      );

      /*
       * Initial UI.
       */
      updateGameUI();

      console.info(
        "[BLACKJACK] Initial UI sync complete."
      );

      /*
       * IMPORTANT:
       *
       * If Game creation and UI synchronization
       * succeeded, initialization is successful.
       */
      clearFatalError();

      console.info(
        "[BLACKJACK] Startup completed successfully."
      );

      /*
       * Finish loading overlay after the
       * first visual intro window.
       */
      window.setTimeout(
        () => {

          if (
            destroyed ||
            !game ||
            fatalVisible
          ) {
            return;
          }

          hideLoading();

          try {
            updateGameUI();
          } catch (error) {

            safeLog(
              "[BLACKJACK] Final UI refresh failed.",
              error
            );
          }

        },
        950
      );

    } catch (error) {

      safeLog(
        "[BLACKJACK] INITIALIZATION FAILED",
        error
      );

      clearEngineSubscriptions();

      try {
        game?.destroy();
      } catch (destroyError) {

        safeLog(
          "[BLACKJACK] Failed to destroy broken Game instance.",
          destroyError
        );
      }

      game =
        null;

      exposeDebugGame();

      showFatalError(
        error
      );

    } finally {

      initializing =
        false;
    }
  }

  /* =========================================================
     START
     ========================================================= */

  initialize();

  /* =========================================================
     PAGE LIFECYCLE
     ========================================================= */

  window.addEventListener(
    "pagehide",
    destroy,
    {
      once: true,
    }
  );
</script>

