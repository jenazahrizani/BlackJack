<div class="casino-shell">
  <main
    class="game-stage"
    aria-label="First-person Blackjack 21 casino table"
  >
    <canvas
      id="game-canvas"
      class="game-canvas"
      aria-label="Blackjack casino table"
    ></canvas>

    <div
      class="ambient-info ambient-info--left"
      aria-hidden="true"
    >
      <span>TABLE 07</span>
    </div>

    <div
      class="ambient-info ambient-info--right"
      aria-hidden="true"
    >
      <span>BLACKJACK 21</span>
    </div>

    <div
      class="player-foreground"
      aria-hidden="true"
    >
      <div class="player-forearm player-forearm--left"></div>
      <div class="player-forearm player-forearm--right"></div>
      <div class="player-seat-shadow"></div>
    </div>

    <section
      id="game-info"
      class="game-info"
      aria-label="Current blackjack status"
    >
      <div class="game-info-row">
        <span class="game-info-label">BANK</span>
        <strong id="bankroll-value">$0</strong>
      </div>

      <div class="game-info-row">
        <span class="game-info-label">BET</span>
        <strong id="bet-value">$0</strong>
      </div>

      <div
        id="hand-value"
        class="game-info-value"
        aria-live="polite"
      >
        —
      </div>
    </section>

    <div
      id="round-status"
      class="round-status"
      aria-live="polite"
    >
      PLACE YOUR BET
    </div>

    <div
      id="bet-controls"
      class="bet-controls"
      aria-label="Betting controls"
    >
      <button
        type="button"
        class="table-button table-button--bet"
        data-action="decrease-bet"
        aria-label="Decrease bet by 5"
      >
        −
      </button>

      <div class="bet-amount">
        <span id="bet-display">$0</span>
      </div>

      <button
        type="button"
        class="table-button table-button--bet"
        data-action="increase-bet"
        aria-label="Increase bet by 5"
      >
        +
      </button>
    </div>

    <div
      id="action-controls"
      class="action-controls"
      aria-label="Blackjack actions"
    >
      <button
        type="button"
        class="table-button"
        data-action="deal"
        data-visible-phase="betting"
      >
        DEAL
      </button>

      <button
        type="button"
        class="table-button"
        data-action="hit"
        data-visible-phase="player-turn"
      >
        HIT
      </button>

      <button
        type="button"
        class="table-button"
        data-action="stand"
        data-visible-phase="player-turn"
      >
        STAND
      </button>

      <button
        type="button"
        class="table-button"
        data-action="double"
        data-visible-phase="player-turn"
      >
        DOUBLE
      </button>

      <button
        type="button"
        class="table-button"
        data-action="split"
        data-visible-phase="player-turn"
      >
        SPLIT
      </button>

      <button
        type="button"
        class="table-button"
        data-action="insurance"
        data-visible-phase="insurance"
      >
        INSURE
      </button>

      <button
        type="button"
        class="table-button"
        data-action="decline-insurance"
        data-visible-phase="insurance"
      >
        NO
      </button>

      <button
        type="button"
        class="table-button table-button--danger"
        data-action="surrender"
        data-visible-phase="player-turn"
      >
        SURRENDER
      </button>
    </div>

    <div
      class="table-atmosphere-mark"
      aria-hidden="true"
    >
      <span>DEALER STANDS ON 17</span>
      <i></i>
      <span>BLACKJACK PAYS 3 : 2</span>
    </div>

    <div
      class="scene-vignette"
      aria-hidden="true"
    ></div>

    <div
      class="scene-edge"
      aria-hidden="true"
    ></div>
  </main>

  <div
    id="loading-screen"
    class="loading-screen"
    aria-live="polite"
  >
    <div class="loading-mark">
      <span class="loading-suit">♠</span>

      <div class="loading-copy">
        <span>PRIVATE TABLE</span>
        <strong>BLACKJACK 21</strong>
      </div>
    </div>

    <div
      class="loading-bar"
      aria-hidden="true"
    >
      <div class="loading-bar-fill"></div>
    </div>
  </div>

  <div
    id="game-error"
    class="game-error"
    aria-live="assertive"
    hidden
  >
    <div class="game-error-inner">
      <span class="game-error-mark">!</span>

      <strong>TABLE ERROR</strong>

      <small id="game-error-copy">
        Blackjack failed to initialize.
      </small>

      <button
        id="game-error-reload"
        type="button"
        class="game-button-retry"
      >
        RETRY
      </button>
    </div>
  </div>
</div>

<script>
  import {
    Game,
  } from "../game/Game";


  type Action =
    | "deal"
    | "hit"
    | "stand"
    | "double"
    | "split"
    | "insurance"
    | "decline-insurance"
    | "surrender"
    | "increase-bet"
    | "decrease-bet";


  /* =========================================================
     GAME INSTANCE
     ========================================================= */

  let game:
    Game | null =
    null;

  let initializing =
    false;


  /* =========================================================
     DOM
     ========================================================= */

  const canvas =
    document.querySelector(
      "#game-canvas"
    ) as HTMLCanvasElement | null;

  const loadingScreen =
    document.querySelector(
      "#loading-screen"
    ) as HTMLElement | null;

  const gameError =
    document.querySelector(
      "#game-error"
    ) as HTMLElement | null;

  const gameErrorCopy =
    document.querySelector(
      "#game-error-copy"
    ) as HTMLElement | null;

  const retryButton =
    document.querySelector(
      "#game-error-reload"
    ) as HTMLButtonElement | null;

  const bankrollValue =
    document.querySelector(
      "#bankroll-value"
    ) as HTMLElement | null;

  const betValue =
    document.querySelector(
      "#bet-value"
    ) as HTMLElement | null;

  const betDisplay =
    document.querySelector(
      "#bet-display"
    ) as HTMLElement | null;

  const handValue =
    document.querySelector(
      "#hand-value"
    ) as HTMLElement | null;

  const roundStatus =
    document.querySelector(
      "#round-status"
    ) as HTMLElement | null;

  const betControls =
    document.querySelector(
      "#bet-controls"
    ) as HTMLElement | null;

  const actionControls =
    document.querySelector(
      "#action-controls"
    ) as HTMLElement | null;

  const actionButtons =
    Array.from(
      document.querySelectorAll(
        "[data-action]"
      )
    ) as HTMLButtonElement[];


  /* =========================================================
     HELPERS
     ========================================================= */

  const money =
    (
      value: number
    ): string => {

      const safe =
        Number.isFinite(
          value
        )
          ? value
          : 0;

      return `$${Math.max(
        0,
        Math.floor(
          safe
        )
      )}`;
    };


  const getHuman =
    () =>
      game
        ?.blackjack
        .getHumanPlayer() ??
      null;


  const getHumanHand =
    () =>
      getHuman()
        ?.hand ??
      null;


  const getEnginePhase =
    () =>
      game
        ?.blackjack
        .phase ??
      "waiting";


  const setHidden =
    (
      element:
        | HTMLElement
        | null,
      hidden: boolean
    ): void => {

      if (!element) {
        return;
      }

      element.classList.toggle(
        "is-hidden",
        hidden
      );
    };


  /* =========================================================
     TABLE STATUS
     ========================================================= */

  const isTableAvailable =
    (): boolean => {

      if (
        !game
      ) {
        return false;
      }

      return game.isTableAvailable();
    };


  /* =========================================================
     HAND HELPERS
     ========================================================= */

  const canDouble =
    (): boolean => {

      const player =
        getHuman();

      const hand =
        getHumanHand();

      if (
        !game ||
        !player ||
        !hand
      ) {
        return false;
      }

      if (
        game.blackjack.phase !==
        "player-turn"
      ) {
        return false;
      }

      if (
        game.blackjack.activeSeat !==
        player.seat
      ) {
        return false;
      }

      if (
        hand.cards.length !==
        2
      ) {
        return false;
      }

      return (
        player.balance >=
        hand.bet
      );
    };


  const canSplit =
    (): boolean => {

      const player =
        getHuman();

      const hand =
        getHumanHand();

      if (
        !game ||
        !player ||
        !hand
      ) {
        return false;
      }

      if (
        game.blackjack.phase !==
        "player-turn"
      ) {
        return false;
      }

      if (
        game.blackjack.activeSeat !==
        player.seat
      ) {
        return false;
      }

      if (
        hand.cards.length !==
        2
      ) {
        return false;
      }

      if (
        player.secondaryHand
      ) {
        return false;
      }

      if (
        player.balance <
        hand.bet
      ) {
        return false;
      }

      const first =
        hand.cards[0];

      const second =
        hand.cards[1];

      if (
        !first ||
        !second
      ) {
        return false;
      }

      return (
        first.value ===
        second.value
      );
    };


  const canSurrender =
    (): boolean => {

      const player =
        getHuman();

      const hand =
        getHumanHand();

      if (
        !game ||
        !player ||
        !hand
      ) {
        return false;
      }

      return (
        game.blackjack.allowSurrender &&
        game.blackjack.phase ===
          "player-turn" &&
        game.blackjack.activeSeat ===
          player.seat &&
        hand.cards.length ===
          2 &&
        !hand.blackjack
      );
    };


  /* =========================================================
     RESULT TEXT
     ========================================================= */

  const getResultText =
    (): string => {

      if (!game) {
        return "ROUND OVER";
      }

      const human =
        getHuman();

      if (!human) {
        return "ROUND OVER";
      }

      const settlements =
        game.blackjack.settlements;

      const result =
        settlements.find(
          (
            settlement
          ) => {

            if (
              settlement.playerId !==
              human.id
            ) {
              return false;
            }

            const handId =
              settlement.handId;

            return (
              typeof handId ===
                "string" &&
              !handId.startsWith(
                "insurance-"
              )
            );
          }
        );

      if (!result) {
        return "ROUND OVER";
      }

      switch (
        result.result
      ) {

        case "blackjack":
          return "BLACKJACK";

        case "win":
          return "YOU WIN";

        case "loss":
        case "bust":
          return "YOU LOSE";

        case "push":
          return "PUSH";

        case "surrender":
          return "SURRENDER";

        default:
          return "ROUND OVER";
      }
    };


  /* =========================================================
     UI STATE
     ========================================================= */

  const updateGameUI =
    (): void => {

      if (!game) {
        return;
      }

      const player =
        getHuman();

      if (!player) {

        if (roundStatus) {
          roundStatus.textContent =
            "TABLE READY";
        }

        if (bankrollValue) {
          bankrollValue.textContent =
            "$0";
        }

        if (betValue) {
          betValue.textContent =
            "$0";
        }

        if (betDisplay) {
          betDisplay.textContent =
            "$0";
        }

        if (handValue) {
          handValue.textContent =
            "—";
        }

        setHidden(
          betControls,
          true
        );

        setHidden(
          actionControls,
          true
        );

        return;
      }

      const phase =
        getEnginePhase();

      const hand =
        getHumanHand();

      const balance =
        Number.isFinite(
          player.balance
        )
          ? player.balance
          : 0;

      const bet =
        Number.isFinite(
          player.bet
        )
          ? player.bet
          : 0;


      /* -----------------------------------------------------
         MONEY
         ----------------------------------------------------- */

      if (
        bankrollValue
      ) {
        bankrollValue.textContent =
          money(
            balance
          );
      }

      if (
        betValue
      ) {
        betValue.textContent =
          money(
            bet
          );
      }

      if (
        betDisplay
      ) {
        betDisplay.textContent =
          money(
            bet
          );
      }


      /* -----------------------------------------------------
         HAND VALUE
         ----------------------------------------------------- */

      if (
        handValue
      ) {

        const showHandValue =
          phase ===
            "player-turn" ||
          phase ===
            "dealer-turn" ||
          phase ===
            "settlement" ||
          phase ===
            "complete";

        if (
          showHandValue &&
          hand &&
          hand.cards.length > 0
        ) {
          handValue.textContent =
            String(
              hand.value
            );
        } else {
          handValue.textContent =
            "—";
        }
      }


      /* -----------------------------------------------------
         ROUND STATUS
         ----------------------------------------------------- */

      let status =
        "PLACE YOUR BET";

      switch (
        phase
      ) {

        case "waiting":
        case "betting":

          if (
            bet >=
            game.blackjack.minimumBet
          ) {
            status =
              "READY TO DEAL";
          } else {
            status =
              "PLACE YOUR BET";
          }

          break;


        case "initial-deal":

          status =
            "DEALING";

          break;


        case "insurance":

          status =
            "INSURANCE?";

          break;


        case "player-turn":

          if (
            game.blackjack.activeSeat ===
            player.seat
          ) {
            status =
              "YOUR TURN";
          } else {
            status =
              "OTHER PLAYERS";
          }

          break;


        case "dealer-turn":

          status =
            "DEALER";

          break;


        case "settlement":

          status =
            "SETTLING";

          break;


        case "complete":

          status =
            getResultText();

          break;


        default:

          status =
            "PLACE YOUR BET";

          break;
      }

      if (
        roundStatus
      ) {
        roundStatus.textContent =
          status;
      }


      /* -----------------------------------------------------
         BETTING VISIBILITY
         ----------------------------------------------------- */

      const bettingVisible =
        phase ===
          "waiting" ||
        phase ===
          "betting" ||
        phase ===
          "complete";

      const tableReady =
        isTableAvailable();

      setHidden(
        betControls,
        !(
          bettingVisible &&
          tableReady
        )
      );


      /* -----------------------------------------------------
         ACTION BUTTONS
         ----------------------------------------------------- */

      for (
        const button of
          actionButtons
      ) {

        const action =
          button.dataset
            .action;

        if (!action) {
          continue;
        }

        const visiblePhase =
          button.dataset
            .visiblePhase;

        let visible =
          false;

        switch (
          action
        ) {

          case "increase-bet":
          case "decrease-bet":

            visible =
              bettingVisible &&
              tableReady;

            break;


          case "deal":

            visible =
              bettingVisible &&
              tableReady;

            break;


          case "insurance":
          case "decline-insurance":

            visible =
              phase ===
              "insurance";

            break;


          case "double":

            visible =
              phase ===
                "player-turn" &&
              canDouble();

            break;


          case "split":

            visible =
              phase ===
                "player-turn" &&
              canSplit();

            break;


          case "surrender":

            visible =
              phase ===
                "player-turn" &&
              canSurrender();

            break;


          default:

            visible =
              visiblePhase ===
              phase;

            break;
        }

        button.classList.toggle(
          "is-hidden",
          !visible
        );

        button.disabled =
          !visible ||
          !player;
      }


      /* -----------------------------------------------------
         BETTING BUTTONS
         ----------------------------------------------------- */

      const canAffordMinimum =
        balance >=
        game.blackjack.minimumBet;

      const minimumBet =
        game.blackjack.minimumBet;

      const maximumBet =
        game.blackjack.maximumBet;

      const decreaseButton =
        actionButtons.find(
          (
            button
          ) =>
            button.dataset.action ===
            "decrease-bet"
        );

      const increaseButton =
        actionButtons.find(
          (
            button
          ) =>
            button.dataset.action ===
            "increase-bet"
        );

      if (
        increaseButton
      ) {

        const canIncrease =
          bettingVisible &&
          tableReady &&
          canAffordMinimum &&
          balance > 0 &&
          bet <
            Math.min(
              maximumBet,
              balance
            );

        increaseButton.disabled =
          !canIncrease;
      }

      if (
        decreaseButton
      ) {

        decreaseButton.disabled =
          !(
            bettingVisible &&
            tableReady &&
            bet > 0
          );
      }


      /* -----------------------------------------------------
         DEAL
         ----------------------------------------------------- */

      const dealButton =
        actionButtons.find(
          (
            button
          ) =>
            button.dataset.action ===
            "deal"
        );

      if (
        dealButton
      ) {

        dealButton.disabled =
          !(
            bettingVisible &&
            tableReady &&
            canAffordMinimum &&
            bet >=
              minimumBet
          );
      }


      /* -----------------------------------------------------
         ACTION CONTAINER
         ----------------------------------------------------- */

      const visibleActions =
        actionButtons.some(
          (
            button
          ) =>
            !button.classList.contains(
              "is-hidden"
            )
        );

      setHidden(
        actionControls,
        !visibleActions
      );
    };


  /* =========================================================
     ACTION EXECUTION
     ========================================================= */

  const executeAction =
    (
      action: Action
    ): void => {

      if (!game) {
        return;
      }

      let result;

      try {

        switch (
          action
        ) {

          case "deal":
            result =
              game.deal();
            break;

          case "hit":
            result =
              game.hit();
            break;

          case "stand":
            result =
              game.stand();
            break;

          case "double":
            result =
              game.double();
            break;

          case "split":
            result =
              game.split();
            break;

          case "insurance":
            result =
              game.insurance();
            break;

          case "decline-insurance":
            result =
              game.declineInsurance();
            break;

          case "surrender":
            result =
              game.surrender();
            break;

          case "increase-bet":
            result =
              game.increaseBet(
                5
              );
            break;

          case "decrease-bet":
            result =
              game.decreaseBet(
                5
              );
            break;
        }

      } catch (
        error
      ) {

        console.error(
          `[BLACKJACK ACTION ERROR] ${action}`,
          error
        );

        showFatalError(
          error
        );

        return;
      }

      if (
        result &&
        !result.success
      ) {

        console.warn(
          `Blackjack action "${action}" failed:`,
          result.reason
        );
      }

      updateGameUI();
    };


  /* =========================================================
     BUTTON BINDING
     ========================================================= */

  const buttonHandlers:
    Array<{
      button:
        HTMLButtonElement;

      handler:
        () => void;
    }> = [];


  for (
    const button of
      actionButtons
  ) {

    const rawAction =
      button.dataset
        .action;

    if (
      !rawAction
    ) {
      continue;
    }

    const action =
      rawAction as Action;

    const handler =
      () => {
        executeAction(
          action
        );
      };

    button.addEventListener(
      "click",
      handler
    );

    buttonHandlers.push({
      button,
      handler,
    });
  }


  /* =========================================================
     ENGINE EVENTS
     ========================================================= */

  const engineEventNames = [
    "round:start",
    "round:phase",
    "bet:change",
    "cards:deal",
    "card:draw",
    "card:flip",
    "player:turn",
    "player:action",
    "dealer:turn",
    "dealer:action",
    "round:settle",
    "round:complete",
    "error",
  ] as const;


  const engineUnsubscribers:
    Array<() => void> = [];


  const clearEngineSubscriptions =
    (): void => {

      for (
        const unsubscribe of
          engineUnsubscribers
      ) {

        try {
          unsubscribe();
        } catch (
          error
        ) {
          console.warn(
            "[BLACKJACK] Failed to remove engine subscription.",
            error
          );
        }
      }

      engineUnsubscribers.length =
        0;
    };


  const subscribeToEngine =
    (): void => {

      clearEngineSubscriptions();

      if (
        !game
      ) {
        return;
      }

      for (
        const eventName of
          engineEventNames
      ) {

        try {

          const unsubscribe =
            game.blackjack.on(
              eventName,
              () => {

                try {
                  updateGameUI();
                } catch (
                  error
                ) {
                  console.error(
                    "[BLACKJACK UI UPDATE ERROR]",
                    error
                  );
                }
              }
            );

          engineUnsubscribers.push(
            unsubscribe
          );

        } catch (
          error
        ) {

          console.error(
            `[BLACKJACK] Failed to subscribe to "${eventName}".`,
            error
          );

          throw error;
        }
      }
    };


  /* =========================================================
     GLOBAL DEBUG HANDLE
     ========================================================= */

  const exposeDebugGame =
    (): void => {

      if (
        typeof window ===
        "undefined"
      ) {
        return;
      }

      const debugWindow =
        window as Window & {
          blackjackGame?:
            Game | null;
        };

      debugWindow.blackjackGame =
        game;
    };


  /* =========================================================
     LOADING
     ========================================================= */

  const hideLoading =
    (): void => {

      if (
        loadingScreen
      ) {
        loadingScreen.classList.add(
          "loading-screen--hidden"
        );
      }
    };


  const showLoading =
    (): void => {

      if (
        loadingScreen
      ) {
        loadingScreen.classList.remove(
          "loading-screen--hidden"
        );
      }
    };


  /* =========================================================
     FATAL ERROR
     ========================================================= */

  const showFatalError =
    (
      error?: unknown
    ): void => {

      console.error(
        "[BLACKJACK FATAL ERROR]",
        error
      );

      let message =
        "Blackjack failed to initialize.";

      let stack =
        "";

      if (
        error instanceof Error
      ) {

        message =
          error.message ||
          "Unknown error.";

        stack =
          error.stack ||
          "";

      } else if (
        typeof error ===
        "string"
      ) {

        message =
          error;

      } else if (
        error !== undefined
      ) {

        try {

          message =
            JSON.stringify(
              error,
              null,
              2
            );

        } catch {

          message =
            String(
              error
            );
        }
      }

      const diagnostic =
        [
          message,
          stack
            ? `\nSTACK:\n${stack}`
            : ""
        ].join("");

      if (
        gameErrorCopy
      ) {
        gameErrorCopy.textContent =
          diagnostic;
      }

      if (
        gameError
      ) {
        gameError.hidden =
          false;
      }

      hideLoading();
    };


  const clearFatalError =
    (): void => {

      if (
        gameError
      ) {

        gameError.hidden =
          true;
      }

      if (
        gameErrorCopy
      ) {

        gameErrorCopy.textContent =
          "Blackjack failed to initialize.";
      }
    };


  /* =========================================================
     GLOBAL ERROR CAPTURE
     ========================================================= */

  const globalErrorHandler =
    (
      event: ErrorEvent
    ): void => {

      console.error(
        "[BLACKJACK WINDOW ERROR]",
        {
          message:
            event.message,
          filename:
            event.filename,
          line:
            event.lineno,
          column:
            event.colno,
          error:
            event.error,
        }
      );

      /*
       * Do not overwrite an already displayed initialization
       * error with an unrelated browser error after startup.
       */
      if (
        initializing ||
        !game
      ) {

        if (
          event.error instanceof Error
        ) {

          showFatalError(
            event.error
          );

        } else if (
          event.message
        ) {

          showFatalError(
            new Error(
              [
                event.message,
                event.filename
                  ? ` at ${event.filename}:${event.lineno}:${event.colno}`
                  : ""
              ].join("")
            )
          );
        }
      }
    };


  const unhandledRejectionHandler =
    (
      event: PromiseRejectionEvent
    ): void => {

      console.error(
        "[BLACKJACK UNHANDLED REJECTION]",
        event.reason
      );

      if (
        initializing ||
        !game
      ) {

        if (
          event.reason instanceof Error
        ) {

          showFatalError(
            event.reason
          );

        } else {

          showFatalError(
            new Error(
              String(
                event.reason
              )
            )
          );
        }
      }
    };


  window.addEventListener(
    "error",
    globalErrorHandler
  );

  window.addEventListener(
    "unhandledrejection",
    unhandledRejectionHandler
  );


  /* =========================================================
     INITIALIZATION
     ========================================================= */

  const initialize =
    (): void => {

      if (
        initializing
      ) {
        return;
      }

      initializing =
        true;

      clearFatalError();
      showLoading();


      try {

        console.info(
          "[BLACKJACK] Initialization started."
        );


        /*
         * Clean previous game instance.
         */
        if (
          game
        ) {

          console.info(
            "[BLACKJACK] Destroying previous game instance."
          );

          try {

            game.destroy();

          } catch (
            destroyError
          ) {

            console.warn(
              "[BLACKJACK] Previous game cleanup failed.",
              destroyError
            );
          }

          game =
            null;
        }


        clearEngineSubscriptions();
        exposeDebugGame();


        /*
         * Canvas validation.
         */
        if (
          !canvas
        ) {

          throw new Error(
            "Game canvas was not found."
          );
        }


        if (
          !(canvas instanceof HTMLCanvasElement)
        ) {

          throw new Error(
            "Game canvas is not an HTMLCanvasElement."
          );
        }


        const rect =
          canvas.getBoundingClientRect();


        if (
          rect.width <= 0 ||
          rect.height <= 0
        ) {

          console.warn(
            "[BLACKJACK] Canvas has zero size during initialization.",
            rect
          );
        }


        console.info(
          "[BLACKJACK] Canvas validated.",
          {
            width:
              rect.width,
            height:
              rect.height,
          }
        );


        /*
         * Create Game.
         */
        console.info(
          "[BLACKJACK] Creating Game..."
        );


        game =
          new Game(
            canvas
          );


        console.info(
          "[BLACKJACK] Game created successfully."
        );


        exposeDebugGame();


        /*
         * Engine subscriptions.
         */
        subscribeToEngine();


        console.info(
          "[BLACKJACK] Engine subscriptions ready."
        );


        /*
         * First UI sync.
         */
        updateGameUI();


        console.info(
          "[BLACKJACK] Initial UI sync complete."
        );


        /*
         * Finish cinematic loading.
         */
        window.setTimeout(
          () => {

            if (
              !game
            ) {
              return;
            }

            hideLoading();

            updateGameUI();

          },
          950
        );


      } catch (
        error
      ) {

        console.error(
          "[BLACKJACK] INITIALIZATION FAILED",
          error
        );


        /*
         * Keep the real error visible before
         * clearing the game reference.
         */
        showFatalError(
          error
        );


        clearEngineSubscriptions();


        try {

          game?.destroy();

        } catch (
          destroyError
        ) {

          console.warn(
            "[BLACKJACK] Failed to destroy broken game instance.",
            destroyError
          );
        }


        game =
          null;


        exposeDebugGame();

      } finally {

        initializing =
          false;
      }
    };


  /* =========================================================
     RETRY
     ========================================================= */

  const retryHandler =
    (): void => {

      if (
        initializing
      ) {
        return;
      }

      initialize();
    };


  retryButton?.addEventListener(
    "click",
    retryHandler
  );


  /* =========================================================
     GLOBAL GAME ACTION REFRESH
     ========================================================= */

  const globalActionHandler =
    (): void => {

      try {

        updateGameUI();

      } catch (
        error
      ) {

        console.error(
          "[BLACKJACK] Global action refresh failed.",
          error
        );

        showFatalError(
          error
        );
      }
    };


  window.addEventListener(
    "blackjack:action",
    globalActionHandler
  );


  /* =========================================================
     VISUAL EVENTS
     ========================================================= */

  const visualEventHandler =
    (): void => {

      try {

        updateGameUI();

      } catch (
        error
      ) {

        console.error(
          "[BLACKJACK] Visual event refresh failed.",
          error
        );
      }
    };


  const visualEventNames = [
    "blackjack:visual:card-draw",
    "blackjack:visual:card-flip",
    "blackjack:visual:player-action",
    "blackjack:visual:dealer-action",
    "blackjack:visual:settlement",
    "blackjack:visual:round-complete",
  ] as const;


  for (
    const eventName of
      visualEventNames
  ) {

    window.addEventListener(
      eventName,
      visualEventHandler
    );
  }


  /* =========================================================
     INITIALIZE
     ========================================================= */

  initialize();


  /* =========================================================
     CLEANUP
     ========================================================= */

  window.addEventListener(
    "pagehide",
    () => {

      window.removeEventListener(
        "error",
        globalErrorHandler
      );

      window.removeEventListener(
        "unhandledrejection",
        unhandledRejectionHandler
      );

      window.removeEventListener(
        "blackjack:action",
        globalActionHandler
      );


      for (
        const eventName of
          visualEventNames
      ) {

        window.removeEventListener(
          eventName,
          visualEventHandler
        );
      }


      for (
        const item of
          buttonHandlers
      ) {

        item.button.removeEventListener(
          "click",
          item.handler
        );
      }


      retryButton?.removeEventListener(
        "click",
        retryHandler
      );


      clearEngineSubscriptions();


      try {

        game?.destroy();

      } catch (
        error
      ) {

        console.warn(
          "[BLACKJACK] Cleanup failed.",
          error
        );
      }


      game =
        null;


      exposeDebugGame();
    },
    {
      once:
        true,
    }
  );
</script>

