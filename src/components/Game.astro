---
---

<div class="casino-shell">
  <!-- =========================================================
       AMBIENT CASINO BACKGROUND
       ========================================================= -->

  <div class="ambient">
    <div class="ambient-light ambient-light--left"></div>
    <div class="ambient-light ambient-light--center"></div>
    <div class="ambient-light ambient-light--right"></div>

    <div class="background-table background-table--one"></div>
    <div class="background-table background-table--two"></div>

    <div class="background-lights">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>

  <!-- =========================================================
       MAIN GAME STAGE
       ========================================================= -->

  <main class="game-stage">

    <!-- subtle top vignette -->
    <div class="stage-vignette"></div>

    <!-- =======================================================
         HEADER
         ======================================================= -->

    <header class="casino-header">
      <div class="header-brand">
        <div class="brand-mark">
          ♠
        </div>

        <div class="brand-copy">
          <span class="brand-kicker">ROYAL TABLE</span>
          <strong>BLACKJACK 21</strong>
        </div>
      </div>

      <div class="header-center">
        <div class="table-id">
          TABLE <strong>07</strong>
        </div>

        <div class="table-live">
          <span class="live-dot"></span>
          LIVE
        </div>
      </div>

      <div class="header-right">
        <div class="bankroll">
          <span class="bankroll-label">BALANCE</span>
          <strong>$1,250.00</strong>
        </div>

        <button class="icon-button" type="button" aria-label="Settings">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <!-- =======================================================
         CANVAS
         Game.ts / Renderer.ts will render the physical casino
         scene here.
         ======================================================= -->

    <section class="table-stage" aria-label="Blackjack table">

      <canvas
        id="game-canvas"
        class="game-canvas"
        aria-label="Blackjack casino game"
      ></canvas>

      <!-- =====================================================
           DEALER UI
           ===================================================== -->

      <div class="dealer-ui">

        <div class="dealer-nameplate">
          <div class="dealer-line"></div>

          <div class="dealer-name">
            <span>DEALER</span>
            <strong>EMMA</strong>
          </div>

          <div class="dealer-status">
            <span class="dealer-status-dot"></span>
            DEALING
          </div>
        </div>

        <div class="dealer-score">
          <span>HAND</span>
          <strong>17</strong>
        </div>

      </div>

      <!-- =====================================================
           PLAYER SEATS
           ===================================================== -->

      <div class="seat seat--1">
        <div class="seat-player">
          <div class="player-avatar">
            <div class="avatar-head"></div>
            <div class="avatar-body"></div>
          </div>

          <div class="seat-info">
            <span>SEAT 01</span>
            <strong>MICHAEL</strong>
          </div>
        </div>

        <div class="seat-status">STAND</div>
      </div>

      <div class="seat seat--2">
        <div class="seat-player">
          <div class="player-avatar">
            <div class="avatar-head"></div>
            <div class="avatar-body"></div>
          </div>

          <div class="seat-info">
            <span>SEAT 02</span>
            <strong>OLIVIA</strong>
          </div>
        </div>

        <div class="seat-status">WAIT</div>
      </div>

      <div class="seat seat--3 seat--you">
        <div class="seat-player">
          <div class="player-avatar player-avatar--you">
            <div class="avatar-head"></div>
            <div class="avatar-body"></div>
          </div>

          <div class="seat-info">
            <span>YOUR SEAT</span>
            <strong>PLAYER</strong>
          </div>
        </div>

        <div class="seat-status seat-status--active">
          YOUR TURN
        </div>
      </div>

      <div class="seat seat--4">
        <div class="seat-player">
          <div class="player-avatar">
            <div class="avatar-head"></div>
            <div class="avatar-body"></div>
          </div>

          <div class="seat-info">
            <span>SEAT 04</span>
            <strong>DANIEL</strong>
          </div>
        </div>

        <div class="seat-status">STAND</div>
      </div>

      <!-- =====================================================
           BET AREA
           ===================================================== -->

      <div class="bet-area">

        <div class="bet-ring">
          <div class="bet-ring-inner">
            <span class="bet-label">YOUR BET</span>

            <strong class="bet-value">
              $25
            </strong>

            <span class="bet-limit">
              MIN $5 · MAX $500
            </span>
          </div>
        </div>

        <div class="chip-stack" aria-hidden="true">
          <div class="chip chip--bottom">$5</div>
          <div class="chip chip--middle">$5</div>
          <div class="chip chip--top">$5</div>
        </div>

      </div>

      <!-- =====================================================
           TABLE MESSAGE
           ===================================================== -->

      <div class="table-message">
        <div class="message-line"></div>

        <div class="message-copy">
          <span class="message-kicker">DEALER</span>
          <strong>Your move.</strong>
        </div>

        <div class="message-line"></div>
      </div>

    </section>

    <!-- =======================================================
         PLAYER INFORMATION
         ======================================================= -->

    <section class="player-panel">

      <div class="player-hand-info">
        <div class="hand-label">
          <span>YOUR HAND</span>
          <small>PLAYER</small>
        </div>

        <div class="hand-score">
          <span>VALUE</span>
          <strong>18</strong>
        </div>
      </div>

      <div class="hand-meta">
        <span class="meta-item">
          <i></i>
          2 CARDS
        </span>

        <span class="meta-divider"></span>

        <span class="meta-item">
          <i></i>
          NO BLACKJACK
        </span>
      </div>

    </section>

    <!-- =======================================================
         ACTION BAR
         ======================================================= -->

    <section class="action-area">

      <div class="action-hint">
        <span>AVAILABLE ACTIONS</span>
        <small>CLICK OR USE KEYBOARD</small>
      </div>

      <div class="actions">

        <button
          id="hit"
          class="action-button action-button--primary"
          type="button"
        >
          <span class="action-key">H</span>

          <span class="action-copy">
            <strong>HIT</strong>
            <small>DRAW CARD</small>
          </span>
        </button>

        <button
          id="stand"
          class="action-button"
          type="button"
        >
          <span class="action-key">S</span>

          <span class="action-copy">
            <strong>STAND</strong>
            <small>END HAND</small>
          </span>
        </button>

        <button
          id="double"
          class="action-button"
          type="button"
        >
          <span class="action-key">D</span>

          <span class="action-copy">
            <strong>DOUBLE</strong>
            <small>DOUBLE BET</small>
          </span>
        </button>

        <button
          id="split"
          class="action-button action-button--disabled"
          type="button"
          disabled
        >
          <span class="action-key">P</span>

          <span class="action-copy">
            <strong>SPLIT</strong>
            <small>UNAVAILABLE</small>
          </span>
        </button>

      </div>

    </section>

    <!-- =======================================================
         FOOTER
         ======================================================= -->

    <footer class="casino-footer">

      <div class="footer-left">
        <span>BLACKJACK PAYS</span>
        <strong>3 : 2</strong>
      </div>

      <div class="footer-center">
        <span class="footer-suit">♣</span>
        <span>ROYAL CASINO</span>
        <span class="footer-suit">♦</span>
      </div>

      <div class="footer-right">
        <span>DEALER STANDS</span>
        <strong>ON 17</strong>
      </div>

    </footer>

  </main>

  <!-- =========================================================
       LOADING OVERLAY
       ========================================================= -->

  <div class="loading-screen" id="loading-screen">

    <div class="loading-logo">
      <div class="loading-suit">♠</div>

      <div class="loading-title">
        <span>ROYAL</span>
        <strong>BLACKJACK 21</strong>
      </div>
    </div>

    <div class="loading-progress">
      <div class="loading-progress-bar"></div>
    </div>

    <span class="loading-text">
      PREPARING TABLE
    </span>

  </div>

</div>

<script>
  import { Game } from "../game/Game";

  const canvas = document.querySelector(
    "#game-canvas"
  ) as HTMLCanvasElement | null;

  if (canvas) {
    new Game(canvas);
  }

  /*
   * Temporary presentation behaviour.
   * Later this can be controlled by Game.ts.
   */
  const loadingScreen = document.querySelector(
    "#loading-screen"
  ) as HTMLElement | null;

  if (loadingScreen) {
    window.setTimeout(() => {
      loadingScreen.classList.add("loading-screen--hidden");
    }, 900);
  }
</script>

<style>
  /* ==========================================================
     ROOT
     ========================================================== */

  :global(:root) {
    --black: #050706;
    --black-2: #090d0b;

    --felt: #0b392b;
    --felt-deep: #082a21;
    --felt-light: #124838;

    --gold: #c5a35c;
    --gold-bright: #e4ca87;
    --gold-dark: #80652f;

    --ivory: #e7e1d3;
    --muted: #9c9b91;

    --red: #84282d;

    --panel: rgba(8, 12, 10, 0.88);
    --line: rgba(197, 163, 92, 0.35);

    --pixel-shadow: 4px 4px 0 rgba(0, 0, 0, 0.6);
  }

  /* ==========================================================
     BASE
     ========================================================== */

  .casino-shell {
    position: fixed;
    inset: 0;

    overflow: hidden;

    background:
      radial-gradient(
        ellipse at 50% 38%,
        rgba(24, 73, 57, 0.16),
        transparent 48%
      ),
      #050706;

    color: var(--ivory);

    font-family:
      "Courier New",
      Courier,
      monospace;

    isolation: isolate;
  }

  .game-stage {
    position: relative;

    width: 100%;
    height: 100%;

    overflow: hidden;
  }

  /* ==========================================================
     AMBIENT
     ========================================================== */

  .ambient {
    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.74) 0%,
        rgba(0, 0, 0, 0.16) 26%,
        rgba(0, 0, 0, 0.05) 55%,
        rgba(0, 0, 0, 0.68) 100%
      );
  }

  .ambient-light {
    position: absolute;

    width: 50vw;
    height: 42vw;

    border-radius: 50%;

    filter: blur(50px);

    opacity: 0.2;
  }

  .ambient-light--left {
    left: -25vw;
    top: -22vw;

    background: rgba(196, 157, 78, 0.14);
  }

  .ambient-light--center {
    left: 25%;
    top: -26vw;

    background: rgba(255, 229, 167, 0.08);
  }

  .ambient-light--right {
    right: -25vw;
    top: -18vw;

    background: rgba(170, 137, 74, 0.12);
  }

  .background-table {
    position: absolute;

    width: 34vw;
    height: 13vw;

    border-radius: 50%;

    border: 2px solid rgba(156, 131, 82, 0.14);

    background:
      radial-gradient(
        ellipse at center,
        rgba(17, 65, 50, 0.14),
        rgba(3, 7, 5, 0.02)
      );

    filter: blur(1px);

    opacity: 0.25;
  }

  .background-table--one {
    left: -2vw;
    top: 17vh;

    transform: rotate(-6deg);
  }

  .background-table--two {
    right: -4vw;
    top: 24vh;

    transform: rotate(8deg);
  }

  .background-lights {
    position: absolute;

    inset: 0;

    display: flex;
    justify-content: center;
    gap: 9vw;

    padding-top: 7vh;
  }

  .background-lights span {
    width: 6px;
    height: 6px;

    background: rgba(226, 197, 122, 0.65);

    box-shadow:
      0 0 10px rgba(226, 197, 122, 0.55),
      0 0 24px rgba(226, 197, 122, 0.14);

    opacity: 0.45;
  }

  /* ==========================================================
     VIGNETTE
     ========================================================== */

  .stage-vignette {
    position: absolute;
    inset: 0;

    z-index: 30;

    pointer-events: none;

    background:
      radial-gradient(
        ellipse at center,
        transparent 52%,
        rgba(0, 0, 0, 0.24) 75%,
        rgba(0, 0, 0, 0.78) 100%
      );

    mix-blend-mode: multiply;
  }

  /* ==========================================================
     HEADER
     ========================================================== */

  .casino-header {
    position: absolute;

    top: 0;
    left: 0;
    right: 0;

    z-index: 100;

    height: 78px;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;

    padding: 0 32px;

    border-bottom: 1px solid rgba(197, 163, 92, 0.16);

    background:
      linear-gradient(
        180deg,
        rgba(3, 6, 5, 0.96),
        rgba(3, 6, 5, 0.72)
      );

    backdrop-filter: blur(10px);
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .brand-mark {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    color: var(--gold-bright);

    border: 1px solid rgba(197, 163, 92, 0.58);

    background: rgba(197, 163, 92, 0.05);

    font-size: 19px;

    box-shadow: var(--pixel-shadow);
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-kicker {
    font-size: 9px;
    letter-spacing: 3px;
    color: var(--muted);
  }

  .brand-copy strong {
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--ivory);
  }

  .header-center {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .table-id {
    color: var(--muted);

    font-size: 10px;
    letter-spacing: 2px;
  }

  .table-id strong {
    color: var(--gold-bright);
  }

  .table-live {
    display: flex;
    align-items: center;
    gap: 7px;

    color: rgba(231, 225, 211, 0.78);

    font-size: 9px;
    letter-spacing: 1.5px;
  }

  .live-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #8fae76;

    box-shadow:
      0 0 8px rgba(143, 174, 118, 0.75);
  }

  .header-right {
    justify-self: end;

    display: flex;
    align-items: center;
    gap: 18px;
  }

  .bankroll {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .bankroll-label {
    font-size: 8px;
    letter-spacing: 2px;
    color: var(--muted);
  }

  .bankroll strong {
    font-size: 14px;
    letter-spacing: 1px;

    color: var(--gold-bright);
  }

  .icon-button {
    width: 36px;
    height: 36px;

    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;

    border: 1px solid rgba(197, 163, 92, 0.26);

    background: rgba(255, 255, 255, 0.015);

    cursor: pointer;
  }

  .icon-button:hover {
    border-color: var(--gold);

    background: rgba(197, 163, 92, 0.08);
  }

  .icon-button span {
    width: 13px;
    height: 1px;

    background: rgba(231, 225, 211, 0.65);
  }

  /* ==========================================================
     TABLE STAGE
     ========================================================== */

  .table-stage {
    position: absolute;

    inset:
      78px
      0
      145px
      0;

    display: block;

    overflow: hidden;
  }

  .game-canvas {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    display: block;

    image-rendering: pixelated;

    cursor: default;
  }

  /* ==========================================================
     DEALER UI
     ========================================================== */

  .dealer-ui {
    position: absolute;

    left: 50%;
    top: 10%;

    z-index: 50;

    transform: translateX(-50%);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;

    pointer-events: none;
  }

  .dealer-nameplate {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .dealer-line {
    width: 52px;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--gold-dark)
      );
  }

  .dealer-name {
    display: flex;
    flex-direction: column;
    align-items: center;

    text-shadow:
      2px 2px 0 rgba(0, 0, 0, 0.85);
  }

  .dealer-name span {
    font-size: 8px;

    letter-spacing: 3px;

    color: var(--gold);
  }

  .dealer-name strong {
    margin-top: 3px;

    font-size: 11px;

    letter-spacing: 2px;

    color: var(--ivory);
  }

  .dealer-status {
    display: flex;
    align-items: center;
    gap: 6px;

    font-size: 8px;
    letter-spacing: 1.7px;

    color: rgba(231, 225, 211, 0.54);
  }

  .dealer-status-dot {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: var(--gold);
  }

  .dealer-score {
    display: flex;
    align-items: center;
    gap: 7px;

    padding: 5px 9px;

    border:
      1px solid
      rgba(197, 163, 92, 0.24);

    background: rgba(4, 9, 7, 0.55);
  }

  .dealer-score span {
    font-size: 7px;
    letter-spacing: 1.5px;
    color: rgba(231, 225, 211, 0.45);
  }

  .dealer-score strong {
    font-size: 11px;
    color: var(--gold-bright);
  }

  /* ==========================================================
     SEATS
     ========================================================== */

  .seat {
    position: absolute;

    z-index: 55;

    display: flex;
    align-items: center;
    gap: 10px;

    min-width: 135px;

    padding: 8px 10px;

    border:
      1px solid
      rgba(197, 163, 92, 0.13);

    background:
      linear-gradient(
        90deg,
        rgba(3, 8, 6, 0.58),
        rgba(3, 8, 6, 0.28)
      );

    opacity: 0.8;

    pointer-events: none;

    transition:
      opacity 180ms ease,
      border-color 180ms ease;
  }

  .seat--1 {
    left: 7%;
    top: 44%;
  }

  .seat--2 {
    left: 18%;
    top: 59%;
  }

  .seat--3 {
    left: 50%;
    bottom: 10%;
    transform: translateX(-50%);
  }

  .seat--4 {
    right: 7%;
    top: 44%;
  }

  .seat--you {
    min-width: 180px;

    border-color:
      rgba(197, 163, 92, 0.42);

    background:
      linear-gradient(
        90deg,
        rgba(11, 57, 43, 0.88),
        rgba(7, 28, 22, 0.72)
      );

    box-shadow:
      0 0 0 1px rgba(197, 163, 92, 0.05),
      4px 4px 0 rgba(0, 0, 0, 0.42);

    opacity: 1;
  }

  .seat-player {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .player-avatar {
    position: relative;

    width: 27px;
    height: 27px;

    overflow: hidden;

    border:
      1px solid
      rgba(197, 163, 92, 0.24);

    background:
      linear-gradient(
        180deg,
        #181e1b 0%,
        #101513 100%
      );
  }

  .player-avatar--you {
    border-color:
      rgba(197, 163, 92, 0.54);
  }

  .avatar-head {
    position: absolute;

    top: 4px;
    left: 50%;

    width: 8px;
    height: 9px;

    transform: translateX(-50%);

    border-radius: 45% 45% 42% 42%;

    background: #746657;
  }

  .avatar-body {
    position: absolute;

    left: 50%;
    bottom: -6px;

    width: 19px;
    height: 16px;

    transform: translateX(-50%);

    border-radius: 9px 9px 0 0;

    background: #303a35;
  }

  .seat--2 .avatar-body {
    background: #493b35;
  }

  .seat--4 .avatar-body {
    background: #34374a;
  }

  .seat-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .seat-info span {
    font-size: 7px;

    letter-spacing: 1.5px;

    color: rgba(231, 225, 211, 0.44);
  }

  .seat-info strong {
    font-size: 9px;

    letter-spacing: 1px;

    color: rgba(231, 225, 211, 0.8);
  }

  .seat--you .seat-info strong {
    color: var(--ivory);
  }

  .seat-status {
    margin-left: auto;

    font-size: 7px;

    letter-spacing: 1px;

    color: rgba(231, 225, 211, 0.38);
  }

  .seat-status--active {
    color: var(--gold-bright);
  }

  /* ==========================================================
     BET
     ========================================================== */

  .bet-area {
    position: absolute;

    left: 50%;
    top: 53%;

    z-index: 60;

    transform: translate(-50%, -50%);

    display: flex;
    align-items: center;
    justify-content: center;

    pointer-events: none;
  }

  .bet-ring {
    width: 132px;
    height: 132px;

    padding: 5px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    border:
      1px solid
      rgba(197, 163, 92, 0.28);

    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.5),
      0 8px 20px rgba(0, 0, 0, 0.2);
  }

  .bet-ring-inner {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;

    gap: 4px;

    border-radius: 50%;

    border:
      1px solid
      rgba(197, 163, 92, 0.12);

    background:
      radial-gradient(
        circle at center,
        rgba(8, 39, 29, 0.86),
        rgba(6, 24, 18, 0.5)
      );
  }

  .bet-label {
    font-size: 8px;

    letter-spacing: 2px;

    color: rgba(231, 225, 211, 0.48);
  }

  .bet-value {
    font-size: 21px;

    letter-spacing: 1px;

    color: var(--gold-bright);

    text-shadow:
      2px 2px 0 rgba(0, 0, 0, 0.75);
  }

  .bet-limit {
    font-size: 6px;

    letter-spacing: 1px;

    color: rgba(231, 225, 211, 0.34);
  }

  .chip-stack {
    position: absolute;

    right: -88px;
    bottom: 4px;

    width: 46px;
    height: 62px;
  }

  .chip {
    position: absolute;

    left: 50%;

    width: 38px;
    height: 38px;

    transform: translateX(-50%);

    display: grid;
