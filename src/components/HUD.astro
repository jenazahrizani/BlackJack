---
---

<div class="hud" aria-label="Blackjack interface">

  <!-- =========================================================
       TOP INFORMATION
       ========================================================= -->

  <div class="hud-top">

    <div class="hud-top-left">

      <div class="session-badge">
        <span class="session-light"></span>

        <div class="session-copy">
          <span>PRIVATE TABLE</span>
          <strong>ROOM 07</strong>
        </div>
      </div>

      <div class="shoe-info">
        <span>SHOE</span>
        <strong>02</strong>
      </div>

    </div>

    <div class="hud-top-center">

      <div class="casino-title">
        <span>♠</span>

        <div>
          <small>ROYAL</small>
          <strong>BLACKJACK 21</strong>
        </div>

        <span>♥</span>
      </div>

    </div>

    <div class="hud-top-right">

      <div class="balance">
        <span>BALANCE</span>

        <strong data-balance>
          $1,250.00
        </strong>
      </div>

      <button
        class="hud-icon"
        id="settings-button"
        type="button"
        aria-label="Open settings"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

    </div>

  </div>


  <!-- =========================================================
       DEALER INFORMATION
       ========================================================= -->

  <div class="dealer-status">

    <div class="dealer-status-line"></div>

    <div class="dealer-status-content">

      <div class="dealer-status-kicker">
        DEALER
      </div>

      <div class="dealer-status-name">
        EMMA
      </div>

      <div class="dealer-status-state">
        <span class="dealer-status-dot"></span>
        DEALING
      </div>

    </div>

    <div class="dealer-status-line"></div>

  </div>


  <!-- =========================================================
       TABLE MESSAGE
       ========================================================= -->

  <div
    class="table-announcement"
    data-table-announcement
    aria-live="polite"
  >
    <div class="announcement-rule"></div>

    <div class="announcement-content">

      <span class="announcement-label">
        DEALER
      </span>

      <strong data-announcement-text>
        Your move.
      </strong>

    </div>

    <div class="announcement-rule"></div>
  </div>


  <!-- =========================================================
       PLAYER HAND SUMMARY
       ========================================================= -->

  <div class="player-summary">

    <div class="player-summary-left">

      <div class="summary-label">
        <span>YOUR HAND</span>
        <small>PLAYER</small>
      </div>

      <div class="summary-value">
        <small>VALUE</small>

        <strong data-player-value>
          18
        </strong>
      </div>

    </div>


    <div class="player-summary-middle">

      <div class="summary-pill">
        <span class="summary-pill-dot"></span>
        2 CARDS
      </div>

      <div class="summary-separator"></div>

      <div class="summary-pill">
        <span class="summary-pill-dot"></span>
        BET $25
      </div>

      <div class="summary-separator"></div>

      <div class="summary-pill summary-pill--muted">
        <span class="summary-pill-dot"></span>
        NO BLACKJACK
      </div>

    </div>


    <div class="player-summary-right">

      <div class="current-bet">
        <span>CURRENT BET</span>
        <strong data-bet-value>$25</strong>
      </div>

    </div>

  </div>


  <!-- =========================================================
       ACTION BAR
       ========================================================= -->

  <div class="action-dock">

    <div class="action-header">

      <div>
        <span>PLAYER ACTION</span>
        <small>MAKE YOUR DECISION</small>
      </div>

      <div class="action-turn">
        <span class="turn-indicator"></span>
        YOUR TURN
      </div>

    </div>


    <div class="action-buttons">

      <button
        id="hit"
        class="action action--primary"
        type="button"
        data-action="hit"
      >
        <span class="action-hotkey">H</span>

        <span class="action-text">
          <strong>HIT</strong>
          <small>DRAW CARD</small>
        </span>

        <span class="action-arrow">›</span>
      </button>


      <button
        id="stand"
        class="action"
        type="button"
        data-action="stand"
      >
        <span class="action-hotkey">S</span>

        <span class="action-text">
          <strong>STAND</strong>
          <small>END HAND</small>
        </span>

        <span class="action-arrow">›</span>
      </button>


      <button
        id="double"
        class="action"
        type="button"
        data-action="double"
      >
        <span class="action-hotkey">D</span>

        <span class="action-text">
          <strong>DOUBLE</strong>
          <small>DOUBLE BET</small>
        </span>

        <span class="action-arrow">›</span>
      </button>


      <button
        id="split"
        class="action action--disabled"
        type="button"
        data-action="split"
        disabled
      >
        <span class="action-hotkey">P</span>

        <span class="action-text">
          <strong>SPLIT</strong>
          <small>UNAVAILABLE</small>
        </span>

        <span class="action-arrow">›</span>
      </button>

    </div>


    <div class="action-footer">

      <span>
        PRESS H / S / D / P
      </span>

      <span class="action-footer-divider"></span>

      <span>
        TABLE 07
      </span>

    </div>

  </div>


  <!-- =========================================================
       BET CONTROL
       ========================================================= -->

  <div class="bet-control">

    <div class="bet-control-title">
      <span>BETTING</span>
      <small>ADJUST STAKE</small>
    </div>


    <div class="bet-amount">
      <button
        class="bet-step"
        type="button"
        data-bet-action="decrease"
        aria-label="Decrease bet"
      >
        −
      </button>

      <div class="bet-current">
        <span>$</span>
        <strong data-bet-number>25</strong>
      </div>

      <button
        class="bet-step"
        type="button"
        data-bet-action="increase"
        aria-label="Increase bet"
      >
        +
      </button>
    </div>


    <div class="bet-presets">

      <button type="button" data-bet-preset="5">
        $5
      </button>

      <button type="button" data-bet-preset="10">
        $10
      </button>

      <button type="button" data-bet-preset="25">
        $25
      </button>

      <button type="button" data-bet-preset="50">
        $50
      </button>

      <button type="button" data-bet-preset="100">
        $100
      </button>

    </div>

    <div class="bet-limits">
      MIN $5
      <span></span>
      MAX $500
    </div>

  </div>


  <!-- =========================================================
       SIDE TABLE INFO
       ========================================================= -->

  <div class="side-info side-info--left">

    <div class="side-info-title">
      TABLE RULES
    </div>

    <div class="side-rule">
      <span>BLACKJACK</span>
      <strong>3 : 2</strong>
    </div>

    <div class="side-rule">
      <span>DEALER</span>
      <strong>STANDS 17</strong>
    </div>

    <div class="side-rule">
      <span>DECK</span>
      <strong>6 SHOE</strong>
    </div>

  </div>


  <div class="side-info side-info--right">

    <div class="side-info-title">
      TABLE STATUS
    </div>

    <div class="status-row">
      <span>CONNECTION</span>
      <strong>
        <i></i>
        STABLE
      </strong>
    </div>

    <div class="status-row">
      <span>PLAYERS</span>
      <strong>4 / 5</strong>
    </div>

    <div class="status-row">
      <span>ROUND</span>
      <strong>#01842</strong>
    </div>

  </div>


  <!-- =========================================================
       LOWER TABLE DECORATION
       ========================================================= -->

  <div class="bottom-marking">

    <span>♣</span>

    <div>
      <small>ESTABLISHED</small>
      <strong>ROYAL CASINO</strong>
      <small>BLACKJACK TABLE 07</small>
    </div>

    <span>♦</span>

  </div>


  <!-- =========================================================
       NOTIFICATION
       ========================================================= -->

  <div
    class="notification"
    data-notification
    aria-live="polite"
  >
    <div class="notification-icon">
      !
    </div>

    <div class="notification-content">
      <span>TABLE</span>
      <strong data-notification-text></strong>
    </div>
  </div>

</div>


<script>
  type ActionName =
    | "hit"
    | "stand"
    | "double"
    | "split";

  const hud = document.querySelector(
    ".hud"
  ) as HTMLElement | null;

  if (!hud) {
    throw new Error(
      "HUD.astro: .hud element was not found."
    );
  }

  const announcement =
    hud.querySelector(
      "[data-announcement-text]"
    ) as HTMLElement | null;

  const balance =
    hud.querySelector(
      "[data-balance]"
    ) as HTMLElement | null;

  const playerValue =
    hud.querySelector(
      "[data-player-value]"
    ) as HTMLElement | null;

  const betValue =
    hud.querySelector(
      "[data-bet-value]"
    ) as HTMLElement | null;

  const betNumber =
    hud.querySelector(
      "[data-bet-number]"
    ) as HTMLElement | null;

  const notification =
    hud.querySelector(
      "[data-notification]"
    ) as HTMLElement | null;

  const notificationText =
    hud.querySelector(
      "[data-notification-text]"
    ) as HTMLElement | null;

  let currentBet = 25;

  let currentBalance = 1250;

  /* ============================================================
     UTILS
     ============================================================ */

  function formatMoney(
    value: number
  ) {
    return new Intl.NumberFormat(
      "en-US",
      {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 2,
      }
    ).format(value);
  }

  function updateBetUI() {
    if (betNumber) {
      betNumber.textContent =
        String(currentBet);
    }

    if (betValue) {
      betValue.textContent =
        `$${currentBet}`;
    }
  }

  function showAnnouncement(
    text: string
  ) {
    if (!announcement) {
      return;
    }

    announcement.textContent =
      text;
  }

  function showNotification(
    text: string
  ) {
    if (
      !notification ||
      !notificationText
    ) {
      return;
    }

    notificationText.textContent =
      text;

    notification.classList.add(
      "notification--visible"
    );

    window.setTimeout(() => {
      notification.classList.remove(
        "notification--visible"
      );
    }, 2400);
  }

  /* ============================================================
     ACTIONS
     ============================================================ */

  function emitAction(
    action: ActionName
  ) {
    window.dispatchEvent(
      new CustomEvent(
        "blackjack:action",
        {
          detail: {
            action,
          },
        }
      )
    );

    switch (action) {
      case "hit":
        showAnnouncement(
          "Drawing a card..."
        );
        break;

      case "stand":
        showAnnouncement(
          "Standing."
        );
        break;

      case "double":
        showAnnouncement(
          "Doubling your bet."
        );
        break;

      case "split":
        showAnnouncement(
          "Split requested."
        );
        break;
    }
  }

  const actions =
    hud.querySelectorAll(
      "[data-action]"
    );

  actions.forEach(
    (element) => {
      element.addEventListener(
        "click",
        () => {
          const action =
            element.getAttribute(
              "data-action"
            ) as ActionName | null;

          if (!action) {
            return;
          }

          emitAction(
            action
          );
        }
      );
    }
  );

  /* ============================================================
     BETTING
     ============================================================ */

  const betPresets =
    hud.querySelectorAll(
      "[data-bet-preset]"
    );

  betPresets.forEach(
    (element) => {
      element.addEventListener(
        "click",
        () => {
          const value =
            Number(
              element.getAttribute(
                "data-bet-preset"
              )
            );

          if (
            !Number.isFinite(value)
          ) {
            return;
          }

          currentBet =
            Math.max(
              5,
              Math.min(
                500,
                value
              )
            );

          updateBetUI();

          showNotification(
            `Bet set to $${currentBet}`
          );

          window.dispatchEvent(
            new CustomEvent(
              "blackjack:bet",
              {
                detail: {
                  value:
                    currentBet,
                },
              }
            )
          );
        }
      );
    }
  );

  const betActions =
    hud.querySelectorAll(
      "[data-bet-action]"
    );

  betActions.forEach(
    (element) => {
      element.addEventListener(
        "click",
        () => {
          const action =
            element.getAttribute(
              "data-bet-action"
            );

          if (
            action ===
            "increase"
          ) {
            currentBet =
              Math.min(
                500,
                currentBet + 5
              );
          }

          if (
            action ===
            "decrease"
          ) {
            currentBet =
              Math.max(
                5,
                currentBet - 5
              );
          }

          updateBetUI();
        }
      );
    }
  );

  /* ============================================================
     KEYBOARD
     ============================================================ */

  window.addEventListener(
    "keydown",
    (event) => {
      if (
        event.ctrlKey ||
        event.metaKey ||
        event.altKey
      ) {
        return;
      }

      switch (
        event.key.toLowerCase()
      ) {
        case "h":
          emitAction("hit");
          break;

        case "s":
          emitAction("stand");
          break;

        case "d":
          emitAction("double");
          break;

        case "p":
          emitAction("split");
          break;
      }
    }
  );

  /* ============================================================
     GAME EVENT BRIDGE
     ============================================================ */

  window.addEventListener(
    "blackjack:status",
    (
      event
    ) => {
      const customEvent =
        event as CustomEvent<{
          announcement?: string;
          balance?: number;
          playerValue?: number;
          bet?: number;
          notification?: string;
        }>;

      const detail =
        customEvent.detail;

      if (
        typeof detail.announcement ===
        "string"
      ) {
        showAnnouncement(
          detail.announcement
        );
      }

      if (
        typeof detail.balance ===
        "number"
      ) {
        currentBalance =
          detail.balance;

        if (balance) {
          balance.textContent =
            formatMoney(
              currentBalance
            );
        }
      }

      if (
        typeof detail.playerValue ===
        "number"
      ) {
        if (playerValue) {
          playerValue.textContent =
            String(
              detail.playerValue
            );
        }
      }

      if (
        typeof detail.bet ===
        "number"
      ) {
        currentBet =
          detail.bet;

        updateBetUI();
      }

      if (
        typeof detail.notification ===
        "string"
      ) {
        showNotification(
          detail.notification
        );
      }
    }
  );

  /* ============================================================
     INITIAL STATE
     ============================================================ */

  updateBetUI();
</script>


<style>
  /* ==========================================================
     HUD ROOT
     ========================================================== */

  .hud {
    position: absolute;
    inset: 0;

    z-index: 200;

    pointer-events: none;

    color: #e7e1d3;

    font-family:
      "Courier New",
      Courier,
      monospace;

    user-select: none;
  }

  .hud button {
    font-family: inherit;
  }


  /* ==========================================================
     TOP
     ========================================================== */

  .hud-top {
    position: absolute;

    top: 0;
    left: 0;
    right: 0;

    height: 78px;

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);

    align-items: center;

    padding: 0 30px;

    border-bottom:
      1px solid
      rgba(197, 163, 92, 0.14);

    background:
      linear-gradient(
        180deg,
        rgba(3, 6, 5, 0.93),
        rgba(3, 6, 5, 0.68)
      );

    backdrop-filter:
      blur(9px);

    pointer-events: auto;
  }

  .hud-top-left,
  .hud-top-right {
    display: flex;
    align-items: center;
  }

  .hud-top-left {
    gap: 25px;
  }

  .hud-top-right {
    justify-content: flex-end;

    gap: 18px;
  }

  .session-badge {
    display: flex;
    align-items: center;

    gap: 9px;
  }

  .session-light {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background:
      #95a976;

    box-shadow:
      0 0 8px
      rgba(149, 169, 118, 0.72);
  }

  .session-copy {
    display: flex;
    flex-direction: column;

    gap: 2px;
  }

  .session-copy span {
    font-size: 7px;

    letter-spacing: 2px;

    color:
      rgba(231, 225, 211, 0.34);
  }

  .session-copy strong {
    font-size: 10px;

    letter-spacing: 1.4px;

    color:
      rgba(231, 225, 211, 0.78);
  }

  .shoe-info {
    display: flex;
    flex-direction: column;

    gap: 2px;

    padding-left: 18px;

    border-left:
      1px solid
      rgba(197, 163, 92, 0.16);
  }

  .shoe-info span {
    font-size: 7px;

    letter-spacing: 1.8px;

    color:
      rgba(231, 225, 211, 0.30);
  }

  .shoe-info strong {
    font-size: 10px;

    color:
      rgba(197, 163, 92, 0.76);
  }


  /* ==========================================================
     TITLE
     ========================================================== */

  .hud-top-center {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .casino-title {
    display: flex;
    align-items: center;

    gap: 11px;

    color:
      rgba(197, 163, 92, 0.58);
  }

  .casino-title > span {
    font-size: 11px;

    opacity: 0.65;
  }

  .casino-title > div {
    display: flex;
    align-items: center;
    flex-direction: column;

    gap: 2px;
  }

  .casino-title small {
    font-size: 6px;

    letter-spacing: 4px;

    color:
      rgba(197, 163, 92, 0.60);
  }

  .casino-title strong {
    font-size: 12px;

    letter-spacing: 2px;

    color:
      rgba(231, 225, 211, 0.80);
  }


  /* ==========================================================
     BALANCE
     ========================================================== */

  .balance {
    display: flex;
    flex-direction: column;

    align-items: flex-end;

    gap: 2px;
  }

  .balance span {
    font-size: 7px;

    letter-spacing: 1.8px;

    color:
      rgba(231, 225, 211, 0.34);
  }

  .balance strong {
    font-size: 14px;

    letter-spacing: 1px;

    color:
      #dfc77e;
  }

  .hud-icon {
    width: 35px;
    height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-direction: column;

    gap: 4px;

    border:
      1px solid
      rgba(197, 163, 92, 0.25);

    border-radius: 0;

    background:
      rgba(255, 255, 255, 0.018);

    pointer-events: auto;

    cursor: pointer;
  }

  .hud-icon:hover {
    border-color:
      rgba(197, 163, 92, 0.58);

    background:
      rgba(197, 163, 92, 0.06);
  }

  .hud-icon span {
    width: 13px;
    height: 1px;

    background:
      rgba(231, 225, 211, 0.58);
  }


  /* ==========================================================
     DEALER
     ========================================================== */

  .dealer-status {
    position: absolute;

    top: 95px;
    left: 50%;

    transform:
      translateX(-50%);

    width: min(
      310px,
      42vw
    );

    display: grid;

    grid-template-columns:
      1fr auto 1fr;

    align-items: center;

    gap: 12px;
  }

  .dealer-status-line {
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(197, 163, 92, 0.23)
      );
  }

  .dealer-status-line:last-child {
    background:
      linear-gradient(
        270deg,
        transparent,
        rgba(197, 163, 92, 0.23)
      );
  }

  .dealer-status-content {
    display: flex;
    align-items: center;
    flex-direction: column;

    gap: 3px;

    text-shadow:
      2px 2px 0
      rgba(0, 0, 0, 0.72);
  }

  .dealer-status-kicker {
    font-size: 6px;

    letter-spacing: 3px;

    color:
      rgba(197, 163, 92, 0.68);
  }

  .dealer-status-name {
    font-size: 10px;

    letter-spacing: 2px;

    color:
      rgba(231, 225, 211, 0.76);
  }

  .dealer-status-state {
    display: flex;
    align-items: center;

    gap: 6px;

    font-size: 6px;

    letter-spacing: 1.5px;

    color:
      rgba(231, 225, 211, 0.30);
  }

  .dealer-status-dot {
    width: 4px;
    height: 4px;

    border-radius: 50%;

    background:
      #c5a35c;

    box-shadow:
      0 0 6px
      rgba(197, 163, 92, 0.60);
  }


  /* ==========================================================
     ANNOUNCEMENT
     ========================================================== */

  .table-announcement {
    position: absolute;

    left: 50%;
    top: 34%;

    transform:
      translateX(-50%);

    width: min(
      360px,
      46vw
    );

    display: flex;
    align-items: center;

    gap: 12px;

    transition:
      opacity 160ms ease;
  }

  .announcement-rule {
    flex: 1;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(197, 163, 92, 0.22)
      );
  }

  .announcement-rule:last-child {
    background:
      linear-gradient(
        270deg,
        transparent,
        rgba(197, 163, 92, 0.22)
      );
  }

  .announcement-content {
    display: flex;
    align-items: center;

    flex-direction: column;

    gap: 4px;

    white-space: nowrap;
  }

  .announcement-label {
    font-size: 6px;

    letter-spacing: 2.4px;

    color:
      rgba(197, 163, 92, 0.58);
  }

  .announcement-content strong {
    font-size: 10px;

    letter-spacing: 1.3px;

    color:
      rgba(231, 225, 211, 0.64);
  }


  /* ==========================================================
     PLAYER SUMMARY
     ========================================================== */

  .player-summary {
    position: absolute;

    left: 28px;
    right: 28px;
    bottom: 154px;

    display: grid;

    grid-template-columns:
      1fr auto 1fr;

    align-items: center;

    pointer-events: none;
  }

  .player-summary-left {
    display: flex;
    align-items: center;

    gap: 20px;
  }

  .summary-label {
    display: flex;
    flex-direction: column;

    gap: 3px;
  }

  .summary-label span {
    font-size: 8px;

    letter-spacing: 2px;

    color:
      rgba(197, 163, 92, 0.66);
