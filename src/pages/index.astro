---
import Game from "../components/Game.astro";

const pageTitle = "Blackjack 21";
const pageDescription =
  "First-person procedural pixel-art Blackjack table.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="theme-color"
      content="#020403"
    />

    <meta
      name="color-scheme"
      content="dark"
    />

    <meta
      name="description"
      content={pageDescription}
    />

    <meta
      name="application-name"
      content={pageTitle}
    />

    <meta
      name="robots"
      content="noindex,nofollow"
    />

    <title>{pageTitle}</title>

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
  </head>

  <body>
    <main
      id="blackjack-app"
      class="blackjack-app"
      aria-label="Blackjack 21 first-person casino table"
    >
      <Game />
    </main>
  </body>
</html>

<style>
  /* ==========================================================================
     GLOBAL RESET
     ========================================================================== */

  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }

  :global(html) {
    width: 100%;
    height: 100%;

    margin: 0;
    padding: 0;

    overflow: hidden;

    background: #020403;

    color-scheme: dark;

    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  :global(body) {
    width: 100%;
    height: 100%;

    min-width: 320px;
    min-height: 100dvh;

    margin: 0;
    padding: 0;

    overflow: hidden;

    background: #020403;

    color: #e7e1d3;

    font-family:
      "Courier New",
      Courier,
      monospace;

    user-select: none;

    overscroll-behavior: none;

    touch-action: none;

    -webkit-font-smoothing: none;
    -moz-osx-font-smoothing: grayscale;
  }

  :global(body::-webkit-scrollbar) {
    display: none;
  }

  :global(button),
  :global(input),
  :global(textarea),
  :global(select) {
    font: inherit;
  }

  :global(button) {
    appearance: none;
    -webkit-appearance: none;
  }

  :global(canvas) {
    display: block;

    max-width: none;
    max-height: none;

    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  /* ==========================================================================
     APPLICATION ROOT
     ========================================================================== */

  .blackjack-app {
    position: fixed;

    inset: 0;

    width: 100%;
    height: 100%;

    min-width: 320px;
    min-height: 100dvh;

    margin: 0;
    padding: 0;

    overflow: hidden;

    background: #020403;

    isolation: isolate;
  }

  /* ==========================================================================
     MOBILE / SAFE AREA
     ========================================================================== */

  @media (max-width: 600px) {
    .blackjack-app {
      width: 100vw;
      height: 100dvh;

      min-height: 100dvh;
    }
  }

  /* ==========================================================================
     REDUCED MOTION
     ========================================================================== */

  @media (prefers-reduced-motion: reduce) {
    :global(html),
    :global(body) {
      scroll-behavior: auto;
    }
  }
</style>