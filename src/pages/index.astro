---
import Game from "../components/Game.astro";

const pageTitle = "Blackjack 21";
const pageDescription =
  "First-person procedural pixel-art Blackjack table.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="theme-color"
      content="#020403"
    />

    <meta
      name="color-scheme"
      content="dark"
    />

    <meta
      name="description"
      content={pageDescription}
    />

    <meta
      name="application-name"
      content={pageTitle}
    />

    <meta
      name="robots"
      content="noindex,nofollow"
    />

    <title>{pageTitle}</title>

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
  </head>

  <body>
    <main
      id="blackjack-app"
      class="blackjack-app"
      aria-label="Blackjack 21 first-person casino table"
    >
      <Game />

      <div
        id="boot-overlay"
        class="boot-overlay"
        aria-live="polite"
      >
        <div class="boot-content">
          <div
            class="boot-symbol"
            aria-hidden="true"
          >
            ♠
          </div>

          <div class="boot-label">
            BLACKJACK 21
          </div>

          <div class="boot-divider"></div>

          <div
            id="boot-text"
            class="boot-text"
          >
            ENTERING TABLE
          </div>

          <div
            class="boot-progress"
            aria-hidden="true"
          >
            <span></span>
          </div>
        </div>
      </div>

      <div
        id="fatal-error"
        class="fatal-error"
        role="alert"
        aria-live="assertive"
      >
        <div class="fatal-panel">
          <div class="fatal-title">
            TABLE ERROR
          </div>

          <div
            id="fatal-message"
            class="fatal-message"
          >
            Unable to initialize Blackjack.
          </div>
        </div>
      </div>
    </main>

    <script>
      type BlackjackWindow = Window & {
        __BLACKJACK_INDEX_READY__?: boolean;
      };

      const runtimeWindow =
        window as BlackjackWindow;

      const bootOverlay =
        document.getElementById(
          "boot-overlay"
        );

      const bootText =
        document.getElementById(
          "boot-text"
        );

      const fatalError =
        document.getElementById(
          "fatal-error"
        );

      const fatalMessage =
        document.getElementById(
          "fatal-message"
        );

      /*
       * Prevent duplicate boot handling during client navigation.
       */
      if (
        !runtimeWindow.__BLACKJACK_INDEX_READY__
      ) {
        runtimeWindow.__BLACKJACK_INDEX_READY__ =
          true;

        const setBootText =
          (text: string) => {
            if (bootText) {
              bootText.textContent = text;
            }
          };

        const hideBoot =
          () => {
            if (!bootOverlay) {
              return;
            }

            bootOverlay.classList.add(
              "boot-overlay--hidden"
            );
          };

        const showFatalError =
          (message: string) => {
            if (fatalMessage) {
              fatalMessage.textContent =
                message;
            }

            fatalError?.classList.add(
              "fatal-error--visible"
            );

            bootOverlay?.classList.add(
              "boot-overlay--hidden"
            );
          };

        setBootText(
          "ENTERING TABLE"
        );

        /*
         * Allow Game.astro to construct its canvas and engine.
         */
        requestAnimationFrame(() => {
          setBootText(
            "LIGHTING THE TABLE"
          );

          requestAnimationFrame(() => {
            const canvas =
              document.querySelector(
                "#game-canvas"
              );

            if (
              !(canvas instanceof HTMLCanvasElement)
            ) {
              showFatalError(
                "Game canvas was not found."
              );

              return;
            }

            setBootText(
              "DEALER READY"
            );

            /*
             * The main Game.ts intro is responsible for the actual
             * scene animation. This overlay only establishes the
             * initial transition into the world.
             */
            window.setTimeout(
              () => {
                hideBoot();
              },
              700
            );
          });
        });

        /*
         * Global runtime error reporting.
         */
        window.addEventListener(
          "error",
          (event) => {
            if (
              event.error instanceof Error
            ) {
              console.error(
                "Blackjack runtime error:",
                event.error
              );
            }
          }
        );

        window.addEventListener(
          "unhandledrejection",
          (event) => {
            console.error(
              "Blackjack unhandled rejection:",
              event.reason
            );
          }
        );
      }
    </script>
  </body>
</html>

<style>
  /* ==========================================================================
     GLOBAL RESET
     ========================================================================== */

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    width: 100%;
    height: 100%;

    margin: 0;
    padding: 0;

    overflow: hidden;

    background:
      #020403;

    color-scheme:
      dark;
  }

  :global(body) {
    width: 100%;
    height: 100%;

    min-width: 320px;
    min-height: 100dvh;

    margin: 0;
    padding: 0;

    overflow: hidden;

    background:
      #020403;

    font-family:
      "Courier New",
      Courier,
      monospace;

    user-select:
      none;

    overscroll-behavior:
      none;

    touch-action:
      none;

    -webkit-font-smoothing:
      none;

    -moz-osx-font-smoothing:
      grayscale;
  }

  :global(body::-webkit-scrollbar) {
    display: none;
  }

  :global(button),
  :global(input),
  :global(textarea),
  :global(select) {
    font:
      inherit;
  }

  :global(canvas) {
    display:
      block;

    image-rendering:
      pixelated;
  }

  /* ==========================================================================
     APPLICATION ROOT
     ========================================================================== */

  .blackjack-app {
    position: fixed;
    inset: 0;

    width: 100vw;
    height: 100vh;

    min-width: 320px;
    min-height: 100dvh;

    overflow: hidden;

    background:
      #020403;

    isolation:
      isolate;

    contain:
      strict;
  }

  /* ==========================================================================
     BOOT
     ========================================================================== */

  .boot-overlay {
    position: absolute;
    inset: 0;

    z-index: 500;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
      #020403;

    opacity: 1;
    visibility: visible;

    transition:
      opacity 360ms steps(4, end),
      visibility 360ms steps(4, end);

    pointer-events:
      all;
  }

  .boot-overlay--hidden {
    opacity: 0;

    visibility:
      hidden;

    pointer-events:
      none;
  }

  .boot-content {
    display: flex;
    align-items: center;
    justify-content: center;

    flex-direction: column;

    gap: 9px;

    text-align:
      center;
  }

  .boot-symbol {
    width: 30px;
    height: 30px;

    display: grid;
    place-items: center;

    color:
      #e1c777;

    border:
      1px solid
      rgba(197,163,92,0.30);

    background:
      rgba(197,163,92,0.025);

    font-size:
      19px;

    line-height:
      1;
  }

  .boot-label {
    color:
      rgba(231,225,211,0.82);

    font-size:
      12px;

    line-height:
      1;

    letter-spacing:
      2.4px;
  }

  .boot-divider {
    width:
      58px;

    height:
      1px;

    margin:
      2px 0 3px;

    background:
      #72582b;
  }

  .boot-text {
    color:
      rgba(197,163,92,0.48);

    font-size:
      7px;

    line-height:
      1;

    letter-spacing:
      2px;
  }

  .boot-progress {
    width:
      150px;

    height:
      2px;

    margin-top:
      6px;

    overflow:
      hidden;

    background:
      rgba(197,163,92,0.08);
  }

  .boot-progress span {
    display:
      block;

    width:
      0%;

    height:
      100%;

    background:
      #c5a35c;

    animation:
      bootProgress 800ms steps(8, end) forwards;
  }

  @keyframes bootProgress {
    from {
      width:
        0%;
    }

    to {
      width:
        100%;
    }
  }

  /* ==========================================================================
     FATAL ERROR
     ========================================================================== */

  .fatal-error {
    position: absolute;
    inset: 0;

    z-index: 600;

    display: none;
    align-items: center;
    justify-content: center;

    padding:
      20px;

    background:
      rgba(2,4,3,0.96);
  }

  .fatal-error--visible {
    display:
      flex;
  }

  .fatal-panel {
    width:
      min(360px, 100%);

    padding:
      20px;

    border:
      1px solid
      rgba(138,39,44,0.45);

    background:
      #070A08;

    box-shadow:
      4px 4px 0
      rgba(0,0,0,0.58);

    text-align:
      center;
  }

  .fatal-title {
    margin-bottom:
      10px;

    color:
      #bf666b;

    font-size:
      10px;

    line-height:
      1;

    letter-spacing:
      2px;
  }

  .fatal-message {
    color:
      rgba(231,225,211,0.54);

    font-size:
      8px;

    line-height:
      1.6;
  }

  /* ==========================================================================
     MOBILE
     ========================================================================== */

  @media (max-width: 600px) {
    .boot-symbol {
      width:
        28px;

      height:
        28px;

      font-size:
        17px;
    }

    .boot-label {
      font-size:
        10px;

      letter-spacing:
        2px;
    }

    .boot-progress {
      width:
        130px;
    }
  }

  /* ==========================================================================
     REDUCED MOTION
     ========================================================================== */

  @media (prefers-reduced-motion: reduce) {
    .boot-progress span {
      width:
        100%;

      animation:
        none;
    }

    .boot-overlay {
      transition:
        none;
    }
  }
</style>