{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "allowJs": false,
    "checkJs": false,

    "jsx": "preserve",
    "jsxImportSource": "astro",

    "strict": true,
    "noEmit": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}